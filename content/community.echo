le=\"false\">\n      <circle cx=\"12\" cy=\"12\" r=\"6.5\"></circle>\n      <circle cx=\"12\" cy=\"12\" r=\"2\" fill=\"currentColor\" stroke=\"none\"></circle>\n      <path d=\"M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3\"></path>\n    </svg>\n  </button>\n  <section class=\"state\" id=\"state\" role=\"status\" aria-live=\"polite\" hidden></section>\n</main>`;var gs=document.querySelector(\".lattice-wall-host\"),bs=Tr(echo),wr=null,zn=null,bn=null,yn=!1;async function Lr(e){if(yn)return;let t=e.panel?.id===\"albums\"?\"albums\":\"library\";if(document.body.dataset.desktopWall=String(!!e.desktop),document.body.style.setProperty(\"--desktop-wall-bottom-inset\",String(e.desktop?.bottomInset??0)+\"px\"),t===wr)return;wr=t,zn?.abort(),bn?.(),bn=null;let o=new AbortController;zn=o,document.body.dataset.state=\"booting\";let r=document.createElement(\"div\");r.className=\"lattice-wall\",r.innerHTML=t===\"albums\"?Bn(\"专辑拼贴墙\",\"定位到正在播放的专辑\"):Bn(\"曲库拼贴墙\",\"定位到正在播放的歌曲\"),gs.replaceChildren(r);try{let n=await(t===\"albums\"?Sr:dr)(bs,o.signal);yn||o.signal.aborted?n():(bn=n,parent.postMessage({channel:\"echo:workshop-plugin\",version:1,type:\"desktop-mounted\"},\"*\"))}catch{if(!yn&&!o.signal.aborted){document.body.dataset.state=\"error\";let n=r.querySelector(\"#state\");n&&(n.hidden=!1,n.textContent=\"桌面拼贴墙加载失败，请关闭后重试。\")}}}var ys=echo.ui.onContextChanged(e=>{Lr(e)});echo.ui.getContext().then(e=>Lr(e));window.addEventListener(\"pagehide\",()=>{yn=!0,ys(),zn?.abort(),bn?.()},{once:!0});})();\n"
    },
    {
      "path": "panel.css",
      "content": "/*! Lattice Wall | Copyright (c) 2026 Lattice Wall contributors\n * SPDX-License-Identifier: AGPL-3.0-only\n * See LICENSE and NOTICE.md in the Workshop item for license and source information.\n */\n\n/* 00-base.css */\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\n/* Fallbacks only: main.ts writes the live host appearance tokens inline on <html>. */\n:root {\n  color-scheme: dark;\n  --host-accent: #6678ff;\n  --host-accent-text: #ffffff;\n  --host-app-bg: #0f1116;\n  --host-text: #f2f4f8;\n  --host-muted: #9aa3b5;\n  --host-panel: #171a22;\n  --host-border: #2a2f3b;\n  --host-player: #171a22;\n  --host-accent-2: color-mix(in srgb, var(--host-accent) 45%, var(--host-text));\n  --shade-color: #000000;\n  --wall-background: #000000;\n  --wall-text: #ffffff;\n  --wall-muted: rgb(255 255 255 / 72%);\n}\n\nhtml[data-color-scheme=\"light\"] {\n  color-scheme: light;\n  --host-app-bg: #f3f4f8;\n  --host-text: #15181f;\n  --host-muted: #5f6777;\n  --host-panel: #ffffff;\n  --host-border: #d7dbe4;\n  --host-player: #ffffff;\n}\n\nhtml,\nbody {\n  margin: 0;\n  height: 100%;\n  overflow: hidden;\n}\n\nbody {\n  font-family: var(--ui-font, system-ui, -apple-system, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif);\n  color: var(--host-text);\n  background: var(--wall-background);\n  -webkit-font-smoothing: antialiased;\n}\n\n:focus-visible {\n  outline: 2px solid var(--host-accent);\n  outline-offset: 2px;\n}\n\n.sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  border: 0;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n}\n\nbody[data-reduced-motion=\"true\"] .field__vignette,\nbody[data-reduced-motion=\"true\"] .world {\n  transition: none;\n}\n\n/* 10-wall.css */\n.lattice{\n  position: fixed;\n  inset: 0;\n  overflow: hidden;\n}\n\n.field{\n  position: absolute;\n  inset: 0;\n  /* The camera owns movement; focusing controls must never scroll this canvas. */\n  overflow: clip;\n  touch-action: none;\n  user-select: none;\n  -webkit-user-select: none;\n  cursor: grab;\n  outline: none;\n  isolation: isolate;\n  background: var(--wall-background);\n}\n\nbody[data-dragging=\"true\"] .field{\n  cursor: grabbing;\n}\n\n/* Paint the focus outline above the poster cards. */\n.field:focus-visible{\n  outline: 2px solid color-mix(in srgb, var(--host-accent) 55%, transparent);\n  outline-offset: -2px;\n}\n\n.world{\n  position: absolute;\n  left: 0;\n  top: 0;\n  width: 0;\n  height: 0;\n  transform-origin: 0 0;\n  will-change: transform;\n  z-index: 1;\n}\n\n.wall-depth-scene{\n  position: absolute;\n  inset: 0;\n  transform-origin: 50% 50%;\n  --depth-x: 0;\n  --depth-y: 0;\n  --depth-amount: 0;\n}\n.wall-depth-scene[data-depth-active=\"true\"]::after{\n  content: '';\n  position: absolute;\n  inset: 0;\n  z-index: 2;\n  pointer-events: none;\n  opacity: calc(var(--depth-amount) * .34);\n  background: radial-gradient(ellipse 80% 75% at calc(50% + var(--depth-x) * 30%) calc(50% + var(--depth-y) * 30%), rgb(255 255 255 / 18%), transparent 70%);\n  mix-blend-mode: screen;\n}\n/* Project the shared wall plane after flattening its native UI layers. Keeping a 3D context\n   here lets the full-size scene hit plane occlude controls on the tilted-away half. The scene\n   matrix still supplies perspective; foreground depth comes from the per-layer XY parallax. */\n\n.fisheye-surface{\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  pointer-events: none;\n  z-index: 0;\n}\n.fisheye-surface[hidden]{ display: none; }\n\n.field__vignette{\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  z-index: 2;\n  opacity: 0;\n  transition: opacity 0.3s;\n  background: radial-gradient(ellipse at center, transparent 46%, rgb(0 0 0 / 74%) 100%);\n}\n\nbody[data-vignette=\"true\"] .field__vignette{\n  opacity: 1;\n}\n\nbody[data-lighting=\"daytime\"] .field__vignette{\n  opacity: 0;\n}\n\nhtml[data-color-scheme=\"light\"] .field__vignette{\n  background: radial-gradient(ellipse at center, transparent 46%, rgb(0 0 0 / 48%) 100%);\n}\n\n/* 20-poster.css */\n/* Poster cards. Position and size come from inline `transform` / `width` / `height` written by\n   posterWall.ts; nothing below may set `transform` on `.poster` itself. */\n\n.poster{\n  --expanded-pad: clamp(18px, 4.5%, 40px);\n  position: absolute;\n  left: 0;\n  top: 0;\n  transform-origin: 0 0;\n  box-sizing: border-box;\n  border-radius: 0;\n  overflow: hidden;\n  contain: layout paint;\n  background: var(--host-panel);\n  color: #fff;\n  cursor: pointer;\n  user-select: none;\n  -webkit-tap-highlight-color: transparent;\n}\n\n.world[data-fisheye-surface=\"true\"] .poster{\n  background: transparent;\n  /* UI units follow the curved cover beyond the card's straight four-corner outline. */\n  overflow: visible;\n  contain: layout;\n}\n.world[data-fisheye-surface=\"true\"] .poster__body{ visibility: hidden; }\n\n.poster__meta,\n.poster__lyrics,\n.poster__controls,\n.poster__caption{ transform-origin: 0 0; }\n\n/* Covers stay borderless when focused or expanded. */\n.poster:focus-visible{\n  outline: none;\n}\n\n.poster[data-expanded=\"true\"] {\n  /* Keep the mounted node in place: re-appending it cancels its lighting transitions. */\n  z-index: 10;\n  cursor: default;\n}\n\n/* Layers ------------------------------------------------------------------------------------- */\n\n.poster__body{\n  position: absolute;\n  inset: 0;\n  transform-origin: center;\n  transition: transform .28s cubic-bezier(.2, .8, .2, 1), filter .28s ease;\n}\n\n/* Scale follows pointer or keyboard focus. Lighting is only hover / playing / expanded. */\n.poster:hover .poster__body,\n.poster[data-focused=\"true\"] .poster__body{\n  transform: scale(var(--hx, 1.06), var(--hy, 1.06));\n}\n\n.poster:hover .poster__body{\n  filter: saturate(1.22) brightness(1.16);\n}\n\nbody[data-dragging=\"true\"] .poster .poster__body{\n  transform: none;\n  filter: none;\n}\n\n.poster[data-expanded=\"true\"] .poster__body{\n  transform: none;\n  filter: brightness(1.18) saturate(1.12);\n}\n\n.poster__fallback{\n  position: absolute;\n  inset: 0;\n}\n\n.poster__art{\n  position: absolute;\n  inset: 0;\n  transform-origin: center;\n}\n.world[data-depth=\"true\"] .poster__art{\n  transform: translate(calc(var(--depth-x) * var(--depth-amount) * var(--depth-art-shift)), calc(var(--depth-y) * var(--depth-amount) * var(--depth-art-shift))) scale(calc(1 + var(--depth-amount) * var(--depth-art-scale)));\n}\n\n.poster__cover{\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  display: block;\n  object-fit: cover;\n  -webkit-user-drag: none;\n}\n\n/* Local album thumbs are centre-cropped squares; preserve that framing in the large variant. */\n.poster[data-square-cover=\"true\"] .poster__cover{\n  inset: auto;\n  left: 50%;\n  top: 50%;\n  width: var(--cover-side, 100%);\n  height: var(--cover-side, 100%);\n  transform: translate(-50%, -50%);\n}\n\n.poster__cover[hidden] {\n  display: none;\n}\n\n.poster__shade{\n  position: absolute;\n  inset: 0;\n  /* Keep the expanded gradient stable; idle covers use their separately configured tint. */\n  background:\n    linear-gradient(180deg, transparent 14%, color-mix(in srgb, var(--shade-color, #000) 48%, transparent) 56%, color-mix(in srgb, var(--shade-color, #000) 94%, transparent) 100%),\n    linear-gradient(90deg, color-mix(in srgb, var(--shade-color, #000) 76%, transparent), transparent 58%),\n    radial-gradient(85% 75% at 0% 100%, color-mix(in srgb, var(--shade-color, #000) 58%, transparent), transparent 72%);\n  opacity: 0;\n  transition: opacity .3s ease;\n}\n\n.poster[data-expanded=\"true\"] .poster__shade{\n  opacity: 1;\n}\n\n.poster__tint{\n  position: absolute;\n  inset: 0;\n  /* theme-color-allow: neutral cover shading must stay black in every host theme. */\n  --tint-fill: color-mix(in srgb, var(--tint-color, #000) calc(var(--tint-alpha, .5) * 100%), transparent);\n  background: var(--tint-fill);\n  opacity: 0;\n  transition: opacity .3s ease;\n}\n\n.world[data-tint-gradient=\"diagonal\"] .poster__tint{\n  /* Gradients add depth above the uniform base. Alpha belongs to each paint layer so the\n     base does not flatten gradients of the same colour; opacity only controls focus fading. */\n  background:\n    linear-gradient(180deg, transparent 38%, color-mix(in srgb, var(--tint-fill) 74%, transparent) 100%),\n    linear-gradient(90deg, color-mix(in srgb, var(--tint-fill) 46%, transparent), transparent 40%),\n    var(--tint-fill);\n}\n\n.world[data-tint-gradient=\"vertical\"] .poster__tint{\n  background:\n    linear-gradient(180deg, transparent 38%, color-mix(in srgb, var(--tint-fill) 74%, transparent) 100%),\n    var(--tint-fill);\n}\n\n.world[data-tint=\"true\"] .poster:not([data-current=\"true\"]):not([data-expanded=\"true\"]):not(:hover) .poster__tint{\n  opacity: 1;\n}\n\nbody[data-dragging=\"true\"] .world[data-tint=\"true\"] .poster:not([data-current=\"true\"]):not([data-expanded=\"true\"]) .poster__tint{\n  opacity: 1;\n}\n\n.poster__lights{\n  position: absolute;\n  inset: 0;\n  background: #000;\n  opacity: 0;\n  transition: opacity .3s ease;\n}\n\n.world[data-lights-out=\"true\"] .poster:not([data-current=\"true\"]):not([data-expanded=\"true\"]):not(:hover) .poster__lights{\n  opacity: .72;\n}\n\nbody[data-dragging=\"true\"] .world[data-lights-out=\"true\"] .poster:not([data-current=\"true\"]):not([data-expanded=\"true\"]) .poster__lights{\n  opacity: .72;\n}\n\n/* An open card is the only bright one; other current-track copies dim with the rest. */\n.world:has(> .poster[data-expanded=\"true\"]) .poster:not([data-expanded=\"true\"]) .poster__lights{\n  opacity: .34;\n}\n\n.world[data-lights-out=\"true\"]:has(> .poster[data-expanded=\"true\"]) .poster:not([data-expanded=\"true\"]) .poster__lights{\n  opacity: .8;\n}\n\n/* Daytime: idle covers stay equally bright. Expanded cards keep their own scrim for type. */\nbody[data-lighting=\"daytime\"] .poster:not([data-expanded=\"true\"]) .poster__shade,\nbody[data-lighting=\"daytime\"] .poster:not([data-expanded=\"true\"]) .poster__tint,\nbody[data-lighting=\"daytime\"] .poster:not([data-expanded=\"true\"]) .poster__lights,\nbody[data-lighting=\"daytime\"] .world:has(> .poster[data-expanded=\"true\"]) .poster:not([data-expanded=\"true\"]) .poster__lights{\n  opacity: 0;\n}\n\n/* Expanded card content ---------------------------------------------------------------------- */\n\n@property --lyrics-open {\n  syntax: '<number>';\n  inherits: true;\n  initial-value: 0;\n}\n\n@property --lyrics-open-height {\n  syntax: '<length>';\n  inherits: true;\n  initial-value: 0px;\n}\n\n.poster__expanded{\n  position: absolute;\n  inset: 0;\n  z-index: 2;\n  display: flex;\n  flex-direction: column;\n  row-gap: 12px;\n  box-sizing: border-box;\n  padding: var(--expanded-pad);\n  opacity: 0;\n  transition: opacity .18s ease;\n}\n\n.poster[data-expanded=\"true\"][data-settled=\"true\"] .poster__expanded{\n  opacity: 1;\n}\n\n.poster__meta{\n  order: 1;\n  margin-top: auto;\n  flex: none;\n  min-width: 0;\n  pointer-events: none;\n  container-type: inline-size;\n}\n\n.poster__title{\n  margin: 0;\n  width: 100%;\n  font-weight: 700;\n  font-size: clamp(56px, 10.5cqw, 96px);\n  line-height: 1.15;\n  font-family: system-ui, -apple-system, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n  letter-spacing: -.02em;\n  text-shadow: 0 2px 14px rgb(0 0 0 / 42%);\n  overflow-wrap: break-word;\n  overflow: visible;\n  padding-inline-end: .04em;\n}\n\n.poster__title-text{\n  display: block;\n  transform-origin: top left;\n  transform: scale(var(--title-scale));\n  /* Stable text raster and line breaks; the parent reserves the actual scaled height. */\n  will-change: transform;\n}\n\n.poster__artist{\n  margin: .35em 0 0;\n  font-size: clamp(16px, 2.2cqw, 24px);\n  line-height: 1.3;\n  color: rgb(255 255 255 / 82%);\n  text-shadow: 0 2px 14px rgb(0 0 0 / 50%);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.poster__artist:empty{\n  display: none;\n}\n\n.poster__lyrics{\n  order: 2;\n  position: relative;\n  flex: 0 0 auto;\n  max-height: 0;\n  min-height: 0;\n  overflow: hidden;\n  /* inline-size only: `size` containment makes auto height ignore children, so the slot stays 0. */\n  container-type: inline-size;\n  /* One inherited progress value drives both directions, including interruptions. */\n}\n\n.poster__lyrics .lyrics{\n  height: auto;\n  overflow: visible;\n  justify-content: flex-start;\n}\n\n/* Taps on the empty controls row (or on a hidden cluster) fall through to the card. */\n.poster__controls{\n  order: 3;\n  flex: none;\n  pointer-events: none;\n}\n\n.poster__controls > *{\n  pointer-events: auto;\n}\n\n/* The queue wall owns this motion; album cards retain their existing layout. */\n.poster__expanded:not(.poster__expanded--album) {\n  flex-direction: column-reverse;\n}\n\n.poster__expanded:not(.poster__expanded--album) .poster__meta{\n  order: 3;\n  margin-top: 0;\n}\n\n.poster__expanded:not(.poster__expanded--album) .poster__controls{\n  order: 1;\n}\n\n.poster__expanded:not(.poster__expanded--album) .poster__title{\n  --title-scale: calc(1 - var(--lyrics-open) * (1 - var(--title-open-scale, 1)));\n  height: calc(var(--title-natural-height) * var(--title-scale));\n}\n\n.poster__expanded:not(.poster__expanded--album) .poster__lyrics{\n  max-height: none;\n  height: calc(var(--lyrics-open-height, 0px) * var(--lyrics-open));\n}\n\n.poster__expanded:not(.poster__expanded--album) .lyrics{\n  transform: translateZ(0);\n  opacity: var(--lyrics-open);\n}\n\n.poster__expanded:not(.poster__expanded--album) .poster__artist{\n  transform: translateZ(0);\n}\n\n/* Entrance wave + fade-in for cards culled in later ------------------------------------------- */\n\n.poster--enter .poster__body{\n  animation: poster-enter .45s cubic-bezier(.2, .8, .2, 1) both;\n  animation-delay: var(--enter-delay, 0s);\n}\n\n.poster--fade .poster__body{\n  animation: poster-fade .12s ease-out both;\n}\n\n@keyframes poster-enter {\n  from {\n    opacity: 0;\n    transform: translate3d(0, 18px, 0);\n  }\n\n  to {\n    opacity: 1;\n    transform: none;\n  }\n}\n\n@keyframes poster-fade {\n  from {\n    opacity: 0;\n  }\n\n  to {\n    opacity: 1;\n  }\n}\n\n/* Reduced motion: no hover scale, no wave, no springs (JS snaps), keep the hover filter --------- */\n\n.world[data-reduced-motion=\"true\"] .poster,\nbody[data-reduced-motion=\"true\"] .poster{\n  transition: none;\n}\n\n.world[data-reduced-motion=\"true\"] .poster .poster__body,\nbody[data-reduced-motion=\"true\"] .poster .poster__body{\n  transform: none;\n  transition: none;\n  animation: none;\n}\n\n.world[data-reduced-motion=\"true\"] .poster .poster__expanded,\nbody[data-reduced-motion=\"true\"] .poster .poster__expanded,\n.world[data-reduced-motion=\"true\"] .poster .poster__meta,\nbody[data-reduced-motion=\"true\"] .poster .poster__meta,\n.world[data-reduced-motion=\"true\"] .poster .poster__title,\nbody[data-reduced-motion=\"true\"] .poster .poster__title,\n.world[data-reduced-motion=\"true\"] .poster .poster__lyrics,\nbody[data-reduced-motion=\"true\"] .poster .poster__lyrics,\n.world[data-reduced-motion=\"true\"] .poster .poster__shade,\nbody[data-reduced-motion=\"true\"] .poster .poster__shade,\n.world[data-reduced-motion=\"true\"] .poster .poster__tint,\nbody[data-reduced-motion=\"true\"] .poster .poster__tint,\n.world[data-reduced-motion=\"true\"] .poster .poster__lights,\nbody[data-reduced-motion=\"true\"] .poster .poster__lights{\n  transition: none;\n  animation: none;\n}\n\n/* 25-caption.css */\n.poster__caption {\n  position: absolute;\n  inset: auto 16px 14px;\n  z-index: 1;\n  display: none;\n  color: var(--wall-text, currentColor);\n  pointer-events: none;\n}\n\nbody[data-show-titles=\"true\"] .poster:not([data-expanded=\"true\"]) > .poster__caption:not([hidden]) {\n  display: block;\n}\n\n.poster__caption-title {\n  display: -webkit-box;\n  overflow: hidden;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: var(--caption-lines, 3);\n  overflow-wrap: anywhere;\n  font-size: 32px;\n  font-weight: 700;\n  line-height: 1.1;\n  letter-spacing: -.025em;\n}\n\n.poster__caption-artist {\n  margin-top: 4px;\n  overflow: hidden;\n  color: var(--wall-muted, currentColor);\n  font-size: 14px;\n  font-weight: 500;\n  line-height: 1.3;\n  white-space: nowrap;\n  text-overflow: ellipsis;\n}\n\n.poster__caption-artist:empty { display: none; }\n\n/* 30-controls.css */\n/* Playback controls: the cluster inside the expanded card, plus the corner locate button. */\n\n.controls {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  min-width: 0;\n  transition: opacity .25s ease;\n}\n\n.controls[data-hidden=\"true\"] {\n  opacity: 0;\n  pointer-events: none;\n}\n\n.controls__row {\n  display: flex;\n  align-items: center;\n  justify-content: flex-start;\n  gap: 0;\n}\n\n.controls__button--skip,\n.controls__button--shuffle,\n.controls__button--repeat,\n.controls__button--lyrics,\n.controls__button--album {\n  overflow: hidden;\n  transition: width .32s cubic-bezier(.2, .8, .2, 1), opacity .28s ease;\n}\n\n.controls[data-mode=\"other\"] .controls__button--skip,\n.controls[data-mode=\"other\"] .controls__button--shuffle,\n.controls[data-mode=\"other\"] .controls__button--repeat,\n.controls[data-mode=\"other\"] .controls__button--lyrics {\n  width: 0;\n  min-width: 0;\n  margin-left: 0;\n  opacity: 0;\n  pointer-events: none;\n}\n\n.controls__button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex: none;\n  width: 52px;\n  height: 52px;\n  padding: 0;\n  border: 0;\n  border-radius: 0;\n  /* theme-color-allow: icons sit on the dark cover shade in both host themes. */\n  background: transparent;\n  color: #fff;\n  cursor: pointer;\n  -webkit-tap-highlight-color: transparent;\n  transition: opacity .15s ease, transform .15s ease;\n}\n\n.controls__button svg {\n  width: 26px;\n  height: 26px;\n}\n\n.controls__button:hover {\n  opacity: .72;\n}\n\n.controls__button:active {\n  transform: scale(.94);\n}\n\n.controls__button:focus-visible {\n  outline: 2px solid #fff;\n  outline-offset: 2px;\n}\n\n.controls__button--primary {\n  width: 64px;\n  height: 64px;\n  background: transparent;\n  color: #fff;\n}\n\n.controls__button--primary svg {\n  width: 30px;\n  height: 30px;\n}\n\n.controls__button--primary:hover {\n  background: transparent;\n}\n\n.controls__button--lyrics[data-on=\"false\"],\n.controls__button--shuffle[data-on=\"false\"],\n.controls__button--repeat[data-on=\"false\"] {\n  opacity: .4;\n}\n\n.controls__glyph {\n  display: inline-flex;\n  line-height: 0;\n}\n\n/* Play / pause glyph swap, driven by data-state on .controls. */\n.controls[data-state=\"playing\"] [data-glyph=\"play\"],\n.controls[data-state=\"paused\"] [data-glyph=\"pause\"] {\n  display: none;\n}\n\n.controls[data-mode=\"other\"] .controls__button--primary [data-glyph=\"play\"] {\n  display: inline-flex;\n}\n\n.controls[data-mode=\"other\"] .controls__button--primary [data-glyph=\"pause\"] {\n  display: none;\n}\n\n/* Seek ---------------------------------------------------------------------------------------- */\n\n.controls__seek {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  width: 50%;\n  min-width: 0;\n}\n\n/* The clock belongs to the playing track; a card for another track has nothing to seek. */\n.controls[data-mode=\"other\"] .controls__seek {\n  display: none;\n}\n\n.controls__slider {\n  -webkit-appearance: none;\n  appearance: none;\n  flex: 1;\n  min-width: 0;\n  height: 16px;\n  margin: 0;\n  padding: 0;\n  border: 0;\n  border-radius: 0;\n  /* theme-color-allow: a thin white fill on the dark cover shade; the thumb is invisible. */\n  background: linear-gradient(90deg, #fff calc(var(--progress, 0) * 100%), rgb(255 255 255 / 28%) 0);\n  background-repeat: no-repeat;\n  background-size: 100% 2px;\n  background-position: 0 50%;\n  outline: none;\n  cursor: pointer;\n}\n\n.controls__slider:focus-visible {\n  box-shadow: 0 0 0 2px rgb(255 255 255 / 35%);\n}\n\n.controls__slider::-webkit-slider-runnable-track {\n  height: 16px;\n  background: transparent;\n}\n\n.controls__slider::-webkit-slider-thumb {\n  -webkit-appearance: none;\n  width: 12px;\n  height: 16px;\n  margin-top: 0;\n  border: 0;\n  border-radius: 0;\n  background: transparent;\n  box-shadow: none;\n}\n\n.controls__time {\n  flex: none;\n  font-size: 13px;\n  font-variant-numeric: tabular-nums;\n  color: rgb(255 255 255 / 85%);\n  white-space: nowrap;\n}\n\n/* Locate button (SPEC §2.5) ------------------------------------------------------------------- */\n\n/* Bottom-right corner; shown only while the playing track's expanded card is off screen. */\n.locate {\n  position: absolute;\n  right: 18px;\n  bottom: 18px;\n  z-index: 5;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 44px;\n  height: 44px;\n  padding: 0;\n  border: 1px solid color-mix(in srgb, var(--host-border) 60%, transparent);\n  border-radius: 50%;\n  background: color-mix(in srgb, var(--host-panel) 80%, transparent);\n  color: var(--host-text);\n  cursor: pointer;\n  backdrop-filter: blur(14px);\n  -webkit-tap-highlight-color: transparent;\n  transition: opacity .25s ease, transform .25s ease, background .15s ease, color .15s ease, visibility 0s linear 0s;\n}\n\n.locate svg {\n  width: 20px;\n  height: 20px;\n}\n\n.locate:hover {\n  background: color-mix(in srgb, var(--host-panel) 92%, var(--host-text));\n  color: var(--host-accent);\n}\n\n.locate:active {\n  transform: scale(.94);\n}\n\n.locate:focus-visible {\n  outline: 2px solid var(--host-accent);\n  outline-offset: 2px;\n}\n\n.locate[data-visible=\"false\"] {\n  opacity: 0;\n  visibility: hidden;\n  transform: translateY(6px);\n  pointer-events: none;\n  transition: opacity .25s ease, transform .25s ease, visibility 0s linear .25s;\n}\n\nbody[data-reduced-motion=\"true\"] .controls,\nbody[data-reduced-motion=\"true\"] .controls__button,\nbody[data-reduced-motion=\"true\"] .controls__button--skip,\nbody[data-reduced-motion=\"true\"] .controls__button--shuffle,\nbody[data-reduced-motion=\"true\"] .controls__button--repeat,\nbody[data-reduced-motion=\"true\"] .controls__button--lyrics,\nbody[data-reduced-motion=\"true\"] .controls__button--album,\nbody[data-reduced-motion=\"true\"] .controls__slider,\nbody[data-reduced-motion=\"true\"] .controls__slider::-webkit-slider-thumb,\nbody[data-reduced-motion=\"true\"] .locate {\n  transition: none;\n}\n\n/* 40-lyrics.css */\n/* Lyrics layer inside the expanded current-track card (SPEC §9). Mounted in `.poster__lyrics`\n   (`container-type: inline-size`), so cqw scales with the card width. Light text on the dark shade. */\n\n.lyrics {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  justify-content: flex-end;\n  gap: clamp(10px, 1.8cqw, 20px);\n  width: 100%;\n  height: 100%;\n  padding: 0;\n  box-sizing: border-box;\n  overflow: hidden;\n  color: var(--host-text, #fff);\n  font-family: system-ui, -apple-system, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n  text-align: left;\n  text-shadow: 0 2px 18px rgb(0 0 0 / 55%);\n  pointer-events: none;\n}\n\n/* Author `display: flex` would otherwise win over the UA `[hidden]` rule. */\n.lyrics[hidden] {\n  display: none;\n}\n\n.lyrics .sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n  border: 0;\n}\n\n.lyrics__line {\n  flex: 0 0 auto;\n  min-width: 0;\n  transform-origin: left center;\n  transition: transform .32s ease, opacity .32s ease, filter .32s ease;\n}\n\n.lyrics__line--current {\n  font-size: clamp(32px, 6.4cqw, 58px);\n  font-weight: 700;\n  opacity: 1;\n  transform: scale(1);\n}\n\n.lyrics__line--next {\n  font-size: clamp(22px, 4.4cqw, 40px);\n  font-weight: 600;\n  opacity: .5;\n  transform: scale(.8);\n  filter: blur(.6px);\n}\n\n.lyrics__text {\n  display: -webkit-box;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 3;\n  overflow: hidden;\n  line-height: 1.25;\n  overflow-wrap: anywhere;\n}\n\n.lyrics__line--next[hidden] {\n  display: none;\n}\n\n.lyrics__line--current .lyrics__text {\n  display: block;\n  overflow: visible;\n  -webkit-line-clamp: unset;\n  text-shadow: none;\n}\n\n.lyrics__translation {\n  display: none;\n  margin-top: .25em;\n  font-size: .62em;\n  font-weight: 500;\n  line-height: 1.3;\n  opacity: .68;\n}\n\n.lyrics[data-translation=\"true\"] .lyrics__translation:not(:empty) {\n  display: -webkit-box;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 2;\n  overflow: hidden;\n}\n\n/* Glow follows glyphs only: no filter / overflow clip, or the bloom becomes a rectangle. */\n.lyrics__word {\n  display: inline;\n  color: rgb(255 255 255 / 38%);\n  text-shadow: none;\n}\n\n.lyrics__word--sung {\n  color: rgb(255 255 255 / 94%);\n}\n\n.lyrics__word--active {\n  color: #fff;\n  text-shadow:\n    0 0 .04em rgb(255 255 255 / 70%),\n    0 0 .14em rgb(255 255 255 / 36%);\n}\n\n.lyrics__plain {\n  flex: 0 1 auto;\n  min-height: 0;\n  max-height: 100%;\n  overflow: auto;\n  overscroll-behavior: contain;\n  pointer-events: auto;\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n  font-size: clamp(22px, 3.6cqw, 32px);\n  line-height: 1.6;\n}\n\n.lyrics__plain::-webkit-scrollbar {\n  width: 6px;\n}\n\n.lyrics__plain::-webkit-scrollbar-thumb {\n  background: rgb(255 255 255 / 30%);\n  border-radius: 3px;\n}\n\n.lyrics__instrumental {\n  text-align: center;\n  font-size: clamp(28px, 5cqw, 46px);\n  font-weight: 600;\n  letter-spacing: .08em;\n  opacity: .85;\n}\n\n/* Light scheme: the layer still sits on the dark shade, so text stays light with a softer shadow. */\nhtml[data-color-scheme=\"light\"] .lyrics,\nbody[data-color-scheme=\"light\"] .lyrics {\n  color: rgb(255 255 255 / 96%);\n  text-shadow: 0 1px 10px rgb(0 0 0 / 40%);\n}\n\nhtml[data-color-scheme=\"light\"] .lyrics__line--current .lyrics__text,\nbody[data-color-scheme=\"light\"] .lyrics__line--current .lyrics__text {\n  text-shadow: none;\n}\n\n/* Reduced motion: no scale, blur or transitions; the whole current line stays highlighted. */\n.lyrics[data-reduced-motion=\"true\"] .lyrics__line,\nbody[data-reduced-motion=\"true\"] .lyrics .lyrics__line {\n  transform: none;\n  filter: none;\n  transition: none;\n}\n\n.lyrics[data-reduced-motion=\"true\"] .lyrics__line--next,\nbody[data-reduced-motion=\"true\"] .lyrics .lyrics__line--next {\n  opacity: .55;\n}\n\n.lyrics[data-reduced-motion=\"true\"] .lyrics__line--current .lyrics__text,\nbody[data-reduced-motion=\"true\"] .lyrics .lyrics__line--current .lyrics__text {\n  filter: none;\n}\n\n.lyrics[data-reduced-motion=\"true\"] .lyrics__word,\nbody[data-reduced-motion=\"true\"] .lyrics .lyrics__word {\n  color: rgb(255 255 255 / 88%);\n  text-shadow: none;\n}\n\n.lyrics[data-reduced-motion=\"true\"] .lyrics__word--active,\n.lyrics[data-reduced-motion=\"true\"] .lyrics__word--sung,\nbody[data-reduced-motion=\"true\"] .lyrics .lyrics__word--active,\nbody[data-reduced-motion=\"true\"] .lyrics .lyrics__word--sung {\n  color: #fff;\n}\n\n/* 50-states.css */\nbody[data-state='booting'] .field,\nbody[data-state='empty'] .field,\nbody[data-state='denied'] .field{\n  opacity: 0;\n  pointer-events: none;\n}\n\nbody[data-state='error'] .field{\n  opacity: 0;\n  pointer-events: none;\n}\n\nbody[data-state='ready'] .field{\n  opacity: 1;\n  transition: opacity 0.35s ease;\n}\n\nbody[data-reduced-motion='true'][data-state='ready'] .field{\n  transition: none;\n}\n\n.state{\n  position: absolute;\n  inset: 0;\n  z-index: 6;\n  display: grid;\n  place-content: center;\n  justify-items: center;\n  gap: 10px;\n  padding: 32px;\n  text-align: center;\n  color: var(--wall-text);\n  background: var(--wall-background);\n}\n\n.state[hidden] {\n  display: none;\n}\n\n.state__title{\n  margin: 0;\n  font-size: clamp(20px, 2.4vw, 28px);\n  font-weight: 700;\n  letter-spacing: -0.01em;\n}\n\n.state__body{\n  max-width: 460px;\n  margin: 0;\n  color: var(--wall-muted);\n  font-size: 14px;\n  line-height: 1.6;\n}\n\n.state[data-state='denied'] .state__title::before{\n  content: '';\n  display: block;\n  width: 10px;\n  height: 10px;\n  margin: 0 auto 14px;\n  border-radius: 50%;\n  background: var(--host-accent);\n  box-shadow: 0 0 0 6px color-mix(in srgb, var(--host-accent) 22%, transparent);\n}\n\n.state[data-state='booting'] .state__title::before{\n  content: '';\n  display: block;\n  width: 18px;\n  height: 18px;\n  margin: 0 auto 14px;\n  border: 2px solid color-mix(in srgb, var(--host-accent) 30%, transparent);\n  border-top-color: var(--host-accent);\n  border-radius: 50%;\n  animation: state-spin 0.9s linear infinite;\n}\n\nbody[data-reduced-motion='true'] .state[data-state='booting'] .state__title::before{\n  animation: none;\n}\n\n@keyframes state-spin {\n  to { transform: rotate(360deg); }\n}\n\n.notice{\n  position: absolute;\n  left: 14px;\n  bottom: 14px;\n  z-index: 5;\n  padding: 5px 10px;\n  border: 1px solid color-mix(in srgb, var(--host-border) 60%, transparent);\n  border-radius: 999px;\n  color: var(--host-muted);\n  background: color-mix(in srgb, var(--host-panel) 82%, transparent);\n  font-size: 11px;\n  letter-spacing: 0.02em;\n  backdrop-filter: blur(12px);\n  pointer-events: none;\n}\n\n/* 60-albums.css */\n@property --album-slot-height{\n  syntax: '<length>';\n  inherits: true;\n  initial-value: 0px;\n}\n.album-tracks :focus-visible{\n  outline: 2px solid var(--wall-text);\n  outline-offset: -2px;\n}\n.poster__expanded.poster__expanded--album{\n  --album-scale: 1;\n  display: flex;\n  flex-direction: column-reverse;\n}\n.poster__expanded--album::before{\n  content: '';\n  position: absolute;\n  inset: 0;\n  z-index: -1;\n  pointer-events: none;\n  /* Blend into the cover instead of outlining the list as a separate card. */\n  background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--wall-background) 72%, transparent) 20%, color-mix(in srgb, var(--wall-background) 82%, transparent));\n  opacity: 0;\n  transition: opacity .22s ease;\n}\n.poster__expanded--album:has(.album-details[data-open=\"true\"])::before{\n  opacity: 1;\n}\n.world[data-fisheye-surface=\"true\"] .poster__expanded--album::before{\n  /* The GPU paints this backdrop through the same continuous lens as the cover. Keep the\n     pseudo-element's opacity timeline available to the renderer, including its closing fade. */\n  visibility: hidden;\n}\n.poster__expanded.poster__expanded--album .poster__meta{\n  order: 3;\n  margin-top: 0;\n  pointer-events: auto;\n}\n.poster__expanded.poster__expanded--album .poster__lyrics{\n  display: grid;\n  order: 2;\n  height: calc(var(--album-slot-height) * var(--lyrics-open));\n  max-height: none;\n  min-height: 0;\n  overflow: hidden;\n}\n.poster__expanded.poster__expanded--album .poster__controls{\n  order: 1;\n}\n.poster__expanded.poster__expanded--album .poster__title{\n  --title-scale: calc(1 - var(--lyrics-open) * (1 - var(--title-open-scale, 1)));\n  height: calc(var(--title-natural-height) * var(--title-scale));\n}\n.poster__expanded.poster__expanded--album .poster__artist{\n  transform: translateZ(0);\n}\n.album-details,\n.album-lyrics{\n  grid-area: 1 / 1;\n  display: flex;\n  flex-direction: column;\n  /* Retain a stable list viewport; the outer slot owns the expansion and clipping. */\n  height: var(--lyrics-open-height, 0px);\n  min-height: 0;\n  min-width: 0;\n  opacity: 1;\n  visibility: visible;\n  transform: translateY(0);\n  transition: opacity .22s ease, transform .22s ease, visibility 0s;\n}\n.album-details[data-open=\"false\"],\n.album-lyrics[data-open=\"false\"] {\n  opacity: 0;\n  visibility: hidden;\n  transform: translateY(calc(10px / var(--album-scale)));\n  pointer-events: none;\n  transition: opacity .22s ease, transform .22s ease, visibility 0s .22s;\n}\n/* Switching content hides the outgoing panel immediately; only the incoming panel fades in.\n   A direct close still fades out, and no intermediate frame paints lyrics over track rows. */\n[data-album-view=\"lyrics\"] .album-details,\n[data-album-view=\"tracks\"] .album-lyrics{\n  visibility: hidden;\n  transition: none;\n}\n.album-lyrics{\n  /* During intrinsic measurement, auto height must not stretch to the hidden track list's\n     grid row. Otherwise the previous list / long lyric height keeps pushing the title up. */\n  align-self: start;\n  justify-content: flex-end;\n  overflow: hidden;\n}\n.poster__expanded--album .album-lyrics .lyrics{\n  max-height: 100%;\n  min-height: 0;\n  overflow: auto;\n  scrollbar-width: none;\n}\n.album-lyrics .lyrics::-webkit-scrollbar{ display: none; }\n.album-details__message{\n  flex-shrink: 0;\n  margin: 0 0 calc(8px / var(--album-scale));\n  padding-inline: calc(12px / var(--album-scale));\n  font-size: calc(13px / var(--album-scale));\n  font-weight: 500;\n  color: var(--wall-muted);\n}\n.album-tracks{\n  flex: 1;\n  min-height: 0;\n  min-width: 0;\n  overflow-x: hidden;\n  overflow-y: auto;\n  overflow-anchor: none;\n  overscroll-behavior: contain;\n  touch-action: pan-y;\n  scrollbar-gutter: stable;\n}\n/* Keep the gutter stable while the thumb is hidden, so row widths never jump. */\n.album-tracks::-webkit-scrollbar{ width: calc(8px / var(--album-scale)); height: calc(8px / var(--album-scale)); background: transparent; }\n.album-tracks::-webkit-scrollbar-track,\n.album-tracks::-webkit-scrollbar-corner{ background: transparent; }\n.album-tracks::-webkit-scrollbar-track{ margin-block: calc(48px / var(--album-scale)); }\n.album-tracks::-webkit-scrollbar-thumb{\n  /* A 4px visible stroke retains an 8px drag target. Insets also shorten its travel. */\n  border: calc(2px / var(--album-scale)) solid transparent;\n  background: transparent;\n  background-clip: padding-box;\n  border-radius: 999px;\n}\n.album-tracks[data-scrolling=\"true\"]::-webkit-scrollbar-thumb{\n  background-color: color-mix(in srgb, var(--wall-text) 45%, transparent);\n}\n.album-tracks[data-scrolling=\"true\"]::-webkit-scrollbar-thumb:hover{\n  background-color: color-mix(in srgb, var(--wall-text) 65%, transparent);\n}\n.album-tracks::-webkit-scrollbar-button{ display: none; width: 0; height: 0; }\n/* Cover text keeps its overlay contrast in both host themes. */\n.album-track-row{\n  display: grid;\n  grid-template-columns: 2.25em minmax(0, 1fr) 4.5em;\n  align-items: center;\n  gap: calc(12px / var(--album-scale));\n  width: 100%;\n  height: var(--album-track-height, calc(48px / var(--album-scale)));\n  padding: calc(8px / var(--album-scale)) calc(12px / var(--album-scale));\n  border: 0;\n  border-bottom: 1px solid color-mix(in srgb, var(--wall-text) 10%, transparent);\n  text-align: left;\n  background: transparent;\n  color: var(--wall-text);\n  font: inherit;\n  font-size: calc(16px / var(--album-scale));\n  font-weight: 500;\n  line-height: 1.4;\n  cursor: pointer;\n  transition: background-color .16s ease;\n}\n.album-tracks__placeholder{ display: flex; color: var(--wall-muted); font-size: calc(13px / var(--album-scale)); }\n.album-tracks__placeholder:not(button) { cursor: default; }\n.album-tracks button:not(:disabled):hover,\n.album-tracks button[aria-current=\"true\"] { background: color-mix(in srgb, var(--wall-text) 6%, transparent); }\n.album-tracks button[aria-current=\"true\"] .album-track__title{ font-weight: 600; }\n.album-tracks button[aria-current=\"true\"] .album-track__number{ color: var(--wall-text); }\n.album-tracks button:disabled{ color: var(--wall-muted); cursor: default; }\n.album-track__title{ overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.album-track__number,\n.album-track__time{ color: color-mix(in srgb, var(--wall-text) 82%, transparent); font-variant-numeric: tabular-nums; font-size: .875em; white-space: nowrap; }\n.album-track__time{ text-align: right; }\n\n.album-content-toggles{\n  display: flex;\n  align-items: center;\n  margin-left: auto;\n  gap: 8px;\n}\n.album-actions .controls__button--album,\n.album-actions .album-content-toggle{\n  width: 64px;\n  height: 64px;\n}\n.album-actions .album-content-toggle{\n  color: var(--wall-text);\n  transition: color .22s ease, opacity .15s ease, transform .15s ease;\n}\n.album-actions .controls__button--album > svg,\n.album-actions .album-content-toggle > svg{ width: 30px; height: 30px; }\n.album-actions .album-content-toggle[hidden] { display: none; }\n.album-content-toggle[aria-expanded=\"false\"] { color: var(--wall-muted); }\n.album-content-toggle:disabled{ opacity: .35; cursor: default; }\n\nbody[data-reduced-motion=\"true\"] .album-details,\nbody[data-reduced-motion=\"true\"] .poster__expanded--album::before,\nbody[data-reduced-motion=\"true\"] .album-lyrics,\nbody[data-reduced-motion=\"true\"] .album-track-row,\nbody[data-reduced-motion=\"true\"] .album-actions .album-content-toggle{\n  transition: none;\n}\n\n.controls.album-actions[data-mode=\"other\"] .controls__button--primary{\n  overflow: hidden;\n  width: 0;\n  min-width: 0;\n  margin-left: 0;\n  opacity: 0;\n  pointer-events: none;\n}\n\n/* 65-control-panel.css */\n.control-panel {\n  position: fixed;\n  inset: 0;\n  width: min(640px, calc(100% - 32px));\n  max-width: none;\n  height: min(560px, calc(100dvh - 48px));\n  max-height: calc(100dvh - 48px);\n  margin: auto;\n  padding: 0;\n  overflow: hidden;\n  border: 1px solid var(--host-border);\n  border-radius: 18px;\n  background: var(--host-panel);\n  color: var(--host-text);\n  font-size: 13px;\n  line-height: 1.5;\n  box-shadow: 0 24px 80px color-mix(in srgb, var(--host-app-bg) 60%, transparent);\n}\n\n.control-panel:not([open]),\n.control-panel [hidden] { display: none; }\n.control-panel::backdrop {\n  background: color-mix(in srgb, var(--host-app-bg) 72%, transparent);\n}\n.control-panel__form {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n  max-height: inherit;\n  margin: 0;\n}\n.control-panel__header {\n  display: flex;\n  flex-shrink: 0;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 18px 24px 16px;\n}\n.control-panel__header h2 {\n  margin: 0 0 4px;\n  font-size: 20px;\n  font-weight: 650;\n  letter-spacing: -.02em;\n}\n.control-panel__body {\n  display: flex;\n  flex-direction: column;\n  flex: 1;\n  min-height: 0;\n  overflow: hidden;\n}\n.control-panel__tabs {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  flex-shrink: 0;\n  gap: 4px;\n  margin: 0 24px;\n  padding-bottom: 12px;\n  border-bottom: 1px solid var(--host-border);\n}\n.control-panel .control-panel__tabs button {\n  min-height: 44px;\n  color: var(--host-muted);\n}\n.control-panel__tabs button[aria-selected=\"true\"] {\n  background: color-mix(in srgb, var(--host-text) 8%, transparent);\n  color: var(--host-text);\n  font-weight: 650;\n}\n.control-panel__pages {\n  flex: 1;\n  min-height: 0;\n  padding: 20px 24px 24px;\n  overflow-y: auto;\n  overscroll-behavior: contain;\n  scrollbar-width: thin;\n  scrollbar-color: var(--host-border) transparent;\n}\n.control-panel__page {\n  display: flex;\n  flex-direction: column;\n  gap: 22px;\n  animation: control-panel-page-in .18s ease-out;\n}\n.control-panel__page > .control-panel__section + .control-panel__section {\n  padding-top: 18px;\n  border-top: 1px solid var(--host-border);\n}\n@keyframes control-panel-page-in {\n  from { opacity: 0; transform: translateY(4px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n.control-panel__section { display: flex; flex-direction: column; gap: 10px; min-width: 0; }\n.control-panel__label { margin: 0; font-size: 13px; font-weight: 650; }\n.control-panel__hint { margin: 0; color: var(--host-muted); font-size: 12px; line-height: 1.6; }\n.control-panel__heading { display: flex; flex-direction: column; gap: 4px; }\n.control-panel__section-heading { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }\n.control-panel__field-label { color: var(--host-muted); white-space: nowrap; }\n.control-panel__row,\n.control-panel__setting-row,\n.control-panel__pager { display: flex; align-items: center; gap: 12px; min-width: 0; }\n.control-panel__setting-row { justify-content: space-between; min-height: 44px; }\n.control-panel__gradient { flex-wrap: wrap; }\n.control-panel__setting-row > .control-panel__field-label { flex-shrink: 0; }\n.control-panel__setting-row select { width: 168px; }\n.control-panel__value { min-width: 46px; color: var(--host-text); font-variant-numeric: tabular-nums; text-align: end; }\n\n.control-panel input,\n.control-panel select {\n  box-sizing: border-box;\n  width: 100%;\n  min-width: 0;\n  min-height: 40px;\n  padding: 0 12px;\n  border: 1px solid var(--host-border);\n  border-radius: 8px;\n  background: color-mix(in srgb, var(--host-app-bg) 65%, var(--host-panel));\n  color: var(--host-text);\n  font: inherit;\n}\n.control-panel input::placeholder { color: var(--host-muted); }\n.control-panel__search > label { display: block; }\n.control-panel input[type=\"search\"] { display: block; margin-top: 6px; min-height: 44px; }\n.control-panel input[type=\"color\"] {\n  width: 40px;\n  min-width: 40px;\n  padding: 5px;\n  cursor: pointer;\n}\n.control-panel input[type=\"color\"]::-webkit-color-swatch-wrapper { padding: 0; }\n.control-panel input[type=\"color\"]::-webkit-color-swatch { border: 1px solid var(--host-border); border-radius: 4px; }\n.control-panel input[type=\"range\"] {\n  flex: 1;\n  min-height: 32px;\n  margin: 0;\n  padding: 0;\n  border: 0;\n  background: transparent;\n  accent-color: var(--host-accent);\n  cursor: pointer;\n}\n.control-panel button {\n  min-height: 36px;\n  padding: 6px 12px;\n  border: 1px solid transparent;\n  border-radius: 8px;\n  background: transparent;\n  color: var(--host-text);\n  font: inherit;\n  white-space: nowrap;\n  cursor: pointer;\n  transition: background-color .16s ease, color .16s ease;\n}\n.control-panel button:hover:not(:disabled) {\n  background: color-mix(in srgb, var(--host-text) 6%, transparent);\n}\n.control-panel button:disabled,\n.control-panel input:disabled { opacity: .45; cursor: default; }\n.control-panel :focus-visible { outline: 2px solid var(--host-accent); outline-offset: 2px; }\n.control-panel .control-panel__dismiss {\n  min-width: 44px;\n  min-height: 36px;\n  padding: 4px 10px;\n  border-color: var(--host-border);\n  color: var(--host-muted);\n  font-size: 12px;\n}\n.control-panel__segments {\n  display: inline-flex;\n  flex-shrink: 0;\n  align-items: center;\n  gap: 3px;\n  padding: 3px;\n  border-radius: 10px;\n  background: color-mix(in srgb, var(--host-app-bg) 75%, var(--host-panel));\n}\n.control-panel__segments button { flex: 1; min-width: 40px; color: var(--host-muted); }\n.control-panel__segments button[aria-pressed=\"true\"] {\n  background: color-mix(in srgb, var(--host-text) 9%, var(--host-panel));\n  color: var(--host-text);\n  font-weight: 600;\n}\n.control-panel__walls { display: flex; margin-bottom: 4px; }\n.control-panel__walls button { min-height: 40px; }\n.control-panel__pager { gap: 4px; margin-top: 8px; }\n.control-panel__pager button { padding-inline: 10px; font-size: 12px; }\n.control-panel__status {\n  flex: 1;\n  min-width: 0;\n  color: var(--host-muted);\n  font-size: 12px;\n  font-variant-numeric: tabular-nums;\n}\n.control-panel__toggles { display: grid; gap: 4px; }\n.control-panel .control-panel__toggle {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  width: 100%;\n  min-width: 0;\n  min-height: 44px;\n  padding: 6px 0;\n  text-align: start;\n  white-space: normal;\n}\n.control-panel .control-panel__toggle:hover:not(:disabled) { background: transparent; }\n.control-panel__switch {\n  position: relative;\n  flex: 0 0 30px;\n  height: 18px;\n  border: 1px solid color-mix(in srgb, var(--host-muted) 45%, var(--host-border));\n  border-radius: 10px;\n  background: color-mix(in srgb, var(--host-muted) 18%, var(--host-panel));\n  transition: background-color .16s ease;\n}\n.control-panel__switch::after {\n  content: '';\n  position: absolute;\n  inset: 3px auto auto 3px;\n  width: 10px;\n  height: 10px;\n  border-radius: 50%;\n  background: var(--host-muted);\n  transition: transform .16s ease, background-color .16s ease;\n}\n.control-panel__toggle[aria-checked=\"true\"] .control-panel__switch { border-color: var(--host-accent); background: var(--host-accent); }\n.control-panel__toggle[aria-checked=\"true\"] .control-panel__switch::after { transform: translateX(12px); background: var(--host-accent-text); }\n.control-panel__toggle:hover:not(:disabled) .control-panel__switch { outline: 3px solid color-mix(in srgb, var(--host-muted) 12%, transparent); }\n.control-panel__shade { grid-template-columns: 1fr 1fr 1.4fr; column-gap: 24px; }\n.control-panel__tint { display: grid; grid-template-columns: 1fr 1.4fr; gap: 24px; }\n.control-panel__tint.is-disabled .control-panel__field-label,\n.control-panel__tint.is-disabled .control-panel__value { opacity: .45; }\n.control-panel__intensity { display: flex; align-items: center; gap: 10px; min-width: 0; }\n.control-panel__lyrics .control-panel__toggles { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 28px; }\n.control-panel__footer {\n  display: flex;\n  flex-shrink: 0;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 12px 24px;\n  border-top: 1px solid var(--host-border);\n  color: var(--host-muted);\n  font-size: 12px;\n}\n.control-panel__shortcut { display: inline-flex; align-items: center; gap: 4px; }\n.control-panel__shortcut-setting { flex-wrap: wrap; }\n.control-panel .control-panel__shortcut-record {\n  min-height: 40px;\n  border-color: var(--host-border);\n  font-variant-numeric: tabular-nums;\n}\n.control-panel .control-panel__shortcut-record[aria-pressed=\"true\"] {\n  border-color: var(--host-accent);\n  color: var(--host-accent);\n}\n.control-panel kbd { padding: 1px 5px; border: 1px solid var(--host-border); border-radius: 4px; font: inherit; }\n\n@media (max-width: 560px) {\n  .control-panel { width: calc(100% - 24px); max-height: calc(100dvh - 24px); border-radius: 14px; }\n  .control-panel__header { padding: 18px 18px 16px; }\n  .control-panel__tabs { margin-inline: 18px; }\n  .control-panel__pages { padding-inline: 18px; }\n  .control-panel__shade { grid-template-columns: minmax(0, 1fr); }\n  .control-panel__lighting > .control-panel__setting-row { align-items: start; }\n  .control-panel__tint { grid-template-columns: minmax(0, 1fr); gap: 4px; }\n  .control-panel__lyrics .control-panel__toggles { grid-template-columns: minmax(0, 1fr); }\n  .control-panel__pager { flex-wrap: wrap; }\n  .control-panel__status { flex-basis: 100%; }\n  .control-panel__pager button { flex: 1; }\n  .control-panel__footer { padding-inline: 18px; }\n}\n\nbody[data-reduced-motion=\"true\"] .control-panel *,\nbody[data-reduced-motion=\"true\"] .control-panel *::after { transition: none; animation: none; }\n@media (prefers-reduced-motion: reduce) {\n  .control-panel *,\n  .control-panel *::after { transition: none; animation: none; }\n}\n\n/* 70-theme.css */\n.lattice-wall-host,\n.lattice-wall {\n  height: 100%;\n}\n\nbody[data-desktop-wall=\"true\"] .locate {\n  bottom: calc(18px + var(--desktop-wall-bottom-inset, 0px));\n}\n"
    },
    {
      "path": "panel.html",
      "content": "<!doctype html>\n<!-- Lattice Wall | Copyright (c) 2026 Lattice Wall contributors | SPDX-License-Identifier: AGPL-3.0-only -->\n<html lang=\"zh-CN\" data-color-scheme=\"dark\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Lattice · 曲库拼贴墙</title>\n  <link rel=\"stylesheet\" href=\"panel.css\">\n</head>\n<body data-state=\"booting\">\n  <main class=\"lattice\" id=\"lattice\">\n    <div class=\"field\" id=\"field\" tabindex=\"0\" role=\"application\" aria-label=\"曲库拼贴墙，Ctrl + Space 打开功能面板\" aria-keyshortcuts=\"Control+Space\">\n      <div class=\"world\" id=\"world\"></div>\n      <div class=\"field__vignette\" aria-hidden=\"true\"></div>\n    </div>\n    <button class=\"locate\" id=\"locate\" type=\"button\" data-visible=\"false\" aria-label=\"定位到正在播放的歌曲\" title=\"定位到正在播放的歌曲 (C)\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\" focusable=\"false\">\n        <circle cx=\"12\" cy=\"12\" r=\"6.5\"/>\n        <circle cx=\"12\" cy=\"12\" r=\"2\" fill=\"currentColor\" stroke=\"none\"/>\n        <path d=\"M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3\"/>\n      </svg>\n    </button>\n    <section class=\"state\" id=\"state\" role=\"status\" aria-live=\"polite\" hidden></section>\n  </main>\n  <script src=\"__bridge__.js\"></script>\n  <script src=\"panel.js\"></script>\n</body>\n</html>\n"
    },
    {
