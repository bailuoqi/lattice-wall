d!==A.focused.id){F(A.focused);return}w()?V():y.play()}},secondary:()=>{if(!A.expanded){A.focused&&F(A.focused);return}w()?V():y.toggle()},escape:()=>{A.expanded?Q():l.closePanel()},focusCurrent:k,toggle:h=>{let $={};b.lightingMode===\"daytime\"&&($.lightingMode=\"spotlight\"),h===\"lights-out\"&&($.lightsOut=!b.lightsOut),h===\"vignette\"&&($.vignette=!b.vignette),h===\"tint\"&&($.posterTint=!b.posterTint),Z($)},seekBy:h=>{if(!y.seekFocused)return!1;let $=q.read(d()),r=Math.max(0,$.positionSeconds+h);return q.seek(r,d()),l.seek(r),M(),!0}});i.addEventListener(\"click\",k);let de=[l.onQueueChanged(h=>{let $=x;N=h.currentTrack,x=mt(T,N),A.setCurrent(x),y.updateCurrent(N?.id??null,w()),b.autoFocus&&$!==x&&x!==null&&k(),M()}),l.onPlaybackStatus(h=>{q.ingest(h,d()),y.updateStatus(h,w()),(h.shuffleEnabled===!0||h.shuffleEnabled===!1)&&(W=h.shuffleEnabled,y.setShuffleEnabled(W)),(h.repeatMode===\"off\"||h.repeatMode===\"one\"||h.repeatMode===\"all\")&&(O=h.repeatMode===\"one\",y.setRepeatOne(O)),M()}),l.onContextChanged(h=>{p=h,et(h),X(),M()}),l.onSettingsChanged(h=>{let $=b;b=nt(h),oe($,null)})];de.push(echo.events.on(\"library:changed\",()=>{s.setNotice(\"曲库已更新，按 Ctrl + Space 打开功能面板并刷新\")}));let me=new ResizeObserver(h=>{let $=h[0]?.contentRect;!$||$.width<1||$.height<1||(R.setViewport($.width,$.height),R.animating||R.setScale((A.expanded?Ke:Ue)($.width)),A.expanded&&A.expandedContent()?.root.style.setProperty(\"--album-scale\",String(B())),t.style.transform=R.transform(),M())});me.observe(e),g.status&&(q.ingest(g.status,d()),y.updateStatus(g.status,!1)),X(),ee(1,\"\"),window.addEventListener(\"pagehide\",()=>{C=!0,cancelAnimationFrame(S),D.cancel();for(let h of de)h();i.removeEventListener(\"click\",k),me.disconnect(),se.dispose(),ne.dispose(),te.dispose(),y.dispose(),A.dispose(),l.dispose(),T=[],L=[]},{once:!0})}To();})();\n"
    },
    {
      "path": "panel.css",
      "content": "/* 00-base.css */\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\n/* Fallbacks only: main.ts writes the live host appearance tokens inline on <html>. */\n:root {\n  color-scheme: dark;\n  --host-accent: #6678ff;\n  --host-accent-text: #ffffff;\n  --host-app-bg: #0f1116;\n  --host-text: #f2f4f8;\n  --host-muted: #9aa3b5;\n  --host-panel: #171a22;\n  --host-border: #2a2f3b;\n  --host-player: #171a22;\n  --host-accent-2: color-mix(in srgb, var(--host-accent) 45%, var(--host-text));\n  --shade-color: #000000;\n}\n\nhtml[data-color-scheme=\"light\"] {\n  color-scheme: light;\n  --host-app-bg: #f3f4f8;\n  --host-text: #15181f;\n  --host-muted: #5f6777;\n  --host-panel: #ffffff;\n  --host-border: #d7dbe4;\n  --host-player: #ffffff;\n}\n\nhtml,\nbody {\n  margin: 0;\n  height: 100%;\n  overflow: hidden;\n}\n\nbody {\n  font-family: var(--ui-font, system-ui, -apple-system, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif);\n  color: var(--host-text);\n  background: var(--host-app-bg);\n  -webkit-font-smoothing: antialiased;\n}\n\n:focus-visible {\n  outline: 2px solid var(--host-accent);\n  outline-offset: 2px;\n}\n\n.sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  border: 0;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n}\n\nbody[data-reduced-motion=\"true\"] .field__vignette,\nbody[data-reduced-motion=\"true\"] .world {\n  transition: none;\n}\n\n/* 10-wall.css */\n.lattice {\n  position: fixed;\n  inset: 0;\n  overflow: hidden;\n}\n\n.field {\n  position: absolute;\n  inset: 0;\n  overflow: hidden;\n  touch-action: none;\n  user-select: none;\n  -webkit-user-select: none;\n  cursor: grab;\n  outline: none;\n  isolation: isolate;\n}\n\nbody[data-dragging=\"true\"] .field {\n  cursor: grabbing;\n}\n\n/* Painted above the children, unlike an inset shadow on .field, which the glow layer would cover. */\n.field:focus-visible {\n  outline: 2px solid color-mix(in srgb, var(--host-accent) 55%, transparent);\n  outline-offset: -2px;\n}\n\n.field::before {\n  content: \"\";\n  position: absolute;\n  inset: -20%;\n  pointer-events: none;\n  z-index: 0;\n  background:\n    radial-gradient(60% 55% at 18% 20%, color-mix(in srgb, var(--host-accent) 34%, transparent), transparent 70%),\n    radial-gradient(55% 60% at 82% 78%, color-mix(in srgb, var(--host-accent-2) 26%, transparent), transparent 70%),\n    var(--host-app-bg);\n}\n\n/*\n * Grain: base64 SVG (220×220) with <feTurbulence type=\"fractalNoise\" baseFrequency=\".85\" numOctaves=\"2\"\n * stitchTiles=\"stitch\"> followed by <feColorMatrix type=\"saturate\" values=\"0\">, filling a <rect>.\n * Plain alpha blending on purpose: a mix-blend-mode here forces the compositor to render the whole\n * isolated .field (the moving wall included) into an offscreen surface on every frame.\n */\n.field::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  z-index: 0;\n  opacity: 0.05;\n  background-image: url(\"data:image/svg+xml;base64,\");\n  background-size: 220px 220px;\n}\n\nhtml[data-color-scheme=\"light\"] .field::before {\n  background:\n    radial-gradient(60% 55% at 18% 20%, color-mix(in srgb, var(--host-accent) 22%, transparent), transparent 70%),\n    radial-gradient(55% 60% at 82% 78%, color-mix(in srgb, var(--host-accent-2) 16%, transparent), transparent 70%),\n    var(--host-app-bg);\n}\n\nhtml[data-color-scheme=\"light\"] .field::after {\n  opacity: 0.035;\n}\n\n.world {\n  position: absolute;\n  left: 0;\n  top: 0;\n  width: 0;\n  height: 0;\n  transform-origin: 0 0;\n  will-change: transform;\n  z-index: 1;\n}\n\n.field__vignette {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  z-index: 2;\n  opacity: 0;\n  transition: opacity 0.3s;\n  background: radial-gradient(ellipse at center, transparent 46%, rgb(0 0 0 / 74%) 100%);\n}\n\nbody[data-vignette=\"true\"] .field__vignette {\n  opacity: 1;\n}\n\nbody[data-lighting=\"daytime\"] .field__vignette {\n  opacity: 0;\n}\n\nhtml[data-color-scheme=\"light\"] .field__vignette {\n  background: radial-gradient(ellipse at center, transparent 46%, rgb(0 0 0 / 48%) 100%);\n}\n\n/* 20-poster.css */\n/* Poster cards. Position and size come from inline `transform` / `width` / `height` written by\n   posterWall.ts; nothing below may set `transform` on `.poster` itself. */\n\n.poster {\n  --expanded-pad: clamp(18px, 4.5%, 40px);\n  position: absolute;\n  left: 0;\n  top: 0;\n  box-sizing: border-box;\n  border-radius: 0;\n  overflow: hidden;\n  contain: layout paint;\n  background: var(--host-panel);\n  color: #fff;\n  cursor: pointer;\n  user-select: none;\n  -webkit-tap-highlight-color: transparent;\n  will-change: transform;\n}\n\n/* Covers stay borderless when focused or expanded. */\n.poster:focus-visible {\n  outline: none;\n}\n\n.poster[data-expanded=\"true\"] {\n  z-index: 10;\n  cursor: default;\n}\n\n/* Layers ------------------------------------------------------------------------------------- */\n\n.poster__body {\n  position: absolute;\n  inset: 0;\n  transform-origin: center;\n  transition: transform .28s cubic-bezier(.2, .8, .2, 1), filter .28s ease;\n}\n\n/* Scale follows pointer or keyboard focus. Lighting is only hover / playing / expanded. */\n.poster:hover .poster__body,\n.poster[data-focused=\"true\"] .poster__body {\n  transform: scale(var(--hx, 1.06), var(--hy, 1.06));\n}\n\n.poster:hover .poster__body {\n  filter: saturate(1.22) brightness(1.16);\n}\n\nbody[data-dragging=\"true\"] .poster .poster__body {\n  transform: none;\n  filter: none;\n}\n\n.poster[data-expanded=\"true\"] .poster__body {\n  transform: none;\n  filter: brightness(1.18) saturate(1.12);\n}\n\n.poster__fallback {\n  position: absolute;\n  inset: 0;\n}\n\n.poster__cover {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  display: block;\n  object-fit: cover;\n  -webkit-user-drag: none;\n}\n\n.poster__cover[hidden] {\n  display: none;\n}\n\n.poster__shade {\n  position: absolute;\n  inset: 0;\n  background:\n    linear-gradient(180deg, transparent 38%, color-mix(in srgb, var(--shade-color, #000) 74%, transparent) 100%),\n    linear-gradient(90deg, color-mix(in srgb, var(--shade-color, #000) 46%, transparent), transparent 40%);\n  opacity: .9;\n}\n\n.poster[data-expanded=\"true\"] .poster__shade {\n  background:\n    linear-gradient(180deg, transparent 14%, color-mix(in srgb, var(--shade-color, #000) 48%, transparent) 56%, color-mix(in srgb, var(--shade-color, #000) 94%, transparent) 100%),\n    linear-gradient(90deg, color-mix(in srgb, var(--shade-color, #000) 76%, transparent), transparent 58%),\n    radial-gradient(85% 75% at 0% 100%, color-mix(in srgb, var(--shade-color, #000) 58%, transparent), transparent 72%);\n  opacity: 1;\n}\n\n.poster__tint {\n  position: absolute;\n  inset: 0;\n  /* theme-color-allow: neutral cover shading must stay black in every host theme. */\n  background: var(--tint-color, #000);\n  opacity: 0;\n  transition: opacity .3s ease;\n}\n\n.world[data-tint=\"true\"] .poster:not([data-current=\"true\"]):not([data-expanded=\"true\"]):not(:hover) .poster__tint {\n  opacity: var(--tint-alpha, .5);\n}\n\nbody[data-dragging=\"true\"] .world[data-tint=\"true\"] .poster:not([data-current=\"true\"]):not([data-expanded=\"true\"]) .poster__tint {\n  opacity: var(--tint-alpha, .5);\n}\n\n.poster__lights {\n  position: absolute;\n  inset: 0;\n  background: #000;\n  opacity: 0;\n  transition: opacity .3s ease;\n}\n\n.world[data-lights-out=\"true\"] .poster:not([data-current=\"true\"]):not([data-expanded=\"true\"]):not(:hover) .poster__lights {\n  opacity: .72;\n}\n\nbody[data-dragging=\"true\"] .world[data-lights-out=\"true\"] .poster:not([data-current=\"true\"]):not([data-expanded=\"true\"]) .poster__lights {\n  opacity: .72;\n}\n\n/* An open card is the only bright one; other current-track copies dim with the rest. */\n.world:has(> .poster[data-expanded=\"true\"]) .poster:not([data-expanded=\"true\"]) .poster__lights {\n  opacity: .34;\n}\n\n.world[data-lights-out=\"true\"]:has(> .poster[data-expanded=\"true\"]) .poster:not([data-expanded=\"true\"]) .poster__lights {\n  opacity: .8;\n}\n\n/* Daytime: idle covers stay equally bright. Expanded cards keep their own scrim for type. */\nbody[data-lighting=\"daytime\"] .poster:not([data-expanded=\"true\"]) .poster__shade,\nbody[data-lighting=\"daytime\"] .poster:not([data-expanded=\"true\"]) .poster__tint,\nbody[data-lighting=\"daytime\"] .poster:not([data-expanded=\"true\"]) .poster__lights,\nbody[data-lighting=\"daytime\"] .world:has(> .poster[data-expanded=\"true\"]) .poster:not([data-expanded=\"true\"]) .poster__lights {\n  opacity: 0;\n}\n\n/* Expanded card content ---------------------------------------------------------------------- */\n\n@property --lyrics-open {\n  syntax: '<number>';\n  inherits: true;\n  initial-value: 0;\n}\n\n.poster__expanded {\n  position: absolute;\n  inset: 0;\n  z-index: 2;\n  display: flex;\n  flex-direction: column;\n  row-gap: 12px;\n  box-sizing: border-box;\n  padding: var(--expanded-pad);\n  opacity: 0;\n  transition: opacity .18s ease;\n}\n\n.poster[data-expanded=\"true\"][data-settled=\"true\"] .poster__expanded {\n  opacity: 1;\n}\n\n.poster__meta {\n  order: 1;\n  margin-top: auto;\n  flex: none;\n  min-width: 0;\n  pointer-events: none;\n  container-type: inline-size;\n}\n\n.poster__title {\n  margin: 0;\n  width: 100%;\n  font-weight: 700;\n  font-size: clamp(56px, 10.5cqw, 96px);\n  line-height: 1.15;\n  font-family: system-ui, -apple-system, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n  letter-spacing: -.02em;\n  text-shadow: 0 2px 14px rgb(0 0 0 / 42%);\n  overflow-wrap: break-word;\n  overflow: visible;\n  padding-inline-end: .04em;\n}\n\n.poster__title-text {\n  display: block;\n  transform-origin: top left;\n  transform: scale(var(--title-scale));\n  /* Stable text raster and line breaks; the parent reserves the actual scaled height. */\n  will-change: transform;\n}\n\n.poster__artist {\n  margin: .35em 0 0;\n  font-size: clamp(16px, 2.2cqw, 24px);\n  line-height: 1.3;\n  color: rgb(255 255 255 / 82%);\n  text-shadow: 0 2px 14px rgb(0 0 0 / 50%);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.poster__artist:empty {\n  display: none;\n}\n\n.poster__lyrics {\n  order: 2;\n  position: relative;\n  flex: 0 0 auto;\n  max-height: 0;\n  min-height: 0;\n  overflow: hidden;\n  /* inline-size only: `size` containment makes auto height ignore children, so the slot stays 0. */\n  container-type: inline-size;\n  /* One inherited progress value drives both directions, including interruptions. */\n}\n\n.poster__lyrics .lyrics {\n  height: auto;\n  overflow: visible;\n  justify-content: flex-start;\n}\n\n/* Taps on the empty controls row (or on a hidden cluster) fall through to the card. */\n.poster__controls {\n  order: 3;\n  flex: none;\n  pointer-events: none;\n}\n\n.poster__controls > * {\n  pointer-events: auto;\n}\n\n/* The queue wall owns this motion; album cards retain their existing layout. */\n.poster__expanded:not(.poster__expanded--album) {\n  flex-direction: column-reverse;\n}\n\n.poster__expanded:not(.poster__expanded--album) .poster__meta {\n  order: 3;\n  margin-top: 0;\n}\n\n.poster__expanded:not(.poster__expanded--album) .poster__controls {\n  order: 1;\n}\n\n.poster__expanded:not(.poster__expanded--album) .poster__title {\n  --title-scale: calc(1 - var(--lyrics-open) * (1 - var(--title-open-scale, 1)));\n  height: calc(var(--title-natural-height) * var(--title-scale));\n}\n\n.poster__expanded:not(.poster__expanded--album) .poster__lyrics {\n  max-height: none;\n  height: calc(var(--lyrics-open-height, 0px) * var(--lyrics-open));\n}\n\n.poster__expanded:not(.poster__expanded--album) .lyrics {\n  transform: translateZ(0);\n  opacity: var(--lyrics-open);\n}\n\n.poster__expanded:not(.poster__expanded--album) .poster__artist {\n  transform: translateZ(0);\n}\n\n/* Entrance wave + fade-in for cards culled in later ------------------------------------------- */\n\n.poster--enter .poster__body {\n  animation: poster-enter .45s cubic-bezier(.2, .8, .2, 1) both;\n  animation-delay: var(--enter-delay, 0s);\n}\n\n.poster--fade .poster__body {\n  animation: poster-fade .12s ease-out both;\n}\n\n@keyframes poster-enter {\n  from {\n    opacity: 0;\n    transform: translate3d(0, 18px, 0);\n  }\n\n  to {\n    opacity: 1;\n    transform: none;\n  }\n}\n\n@keyframes poster-fade {\n  from {\n    opacity: 0;\n  }\n\n  to {\n    opacity: 1;\n  }\n}\n\n/* Reduced motion: no hover scale, no wave, no springs (JS snaps), keep the hover filter --------- */\n\n.world[data-reduced-motion=\"true\"] .poster,\nbody[data-reduced-motion=\"true\"] .poster {\n  transition: none;\n}\n\n.world[data-reduced-motion=\"true\"] .poster .poster__body,\nbody[data-reduced-motion=\"true\"] .poster .poster__body {\n  transform: none;\n  transition: none;\n  animation: none;\n}\n\n.world[data-reduced-motion=\"true\"] .poster .poster__expanded,\nbody[data-reduced-motion=\"true\"] .poster .poster__expanded,\n.world[data-reduced-motion=\"true\"] .poster .poster__meta,\nbody[data-reduced-motion=\"true\"] .poster .poster__meta,\n.world[data-reduced-motion=\"true\"] .poster .poster__title,\nbody[data-reduced-motion=\"true\"] .poster .poster__title,\n.world[data-reduced-motion=\"true\"] .poster .poster__lyrics,\nbody[data-reduced-motion=\"true\"] .poster .poster__lyrics,\n.world[data-reduced-motion=\"true\"] .poster .poster__tint,\nbody[data-reduced-motion=\"true\"] .poster .poster__tint,\n.world[data-reduced-motion=\"true\"] .poster .poster__lights,\nbody[data-reduced-motion=\"true\"] .poster .poster__lights {\n  transition: none;\n  animation: none;\n}\n\n/* 30-controls.css */\n/* Playback controls: the cluster inside the expanded card, plus the corner locate button. */\n\n.controls {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  min-width: 0;\n  transition: opacity .25s ease;\n}\n\n.controls[data-hidden=\"true\"] {\n  opacity: 0;\n  pointer-events: none;\n}\n\n.controls__row {\n  display: flex;\n  align-items: center;\n  justify-content: flex-start;\n  gap: 0;\n}\n\n.controls__button--skip,\n.controls__button--shuffle,\n.controls__button--repeat,\n.controls__button--lyrics,\n.controls__button--album {\n  overflow: hidden;\n  transition: width .32s cubic-bezier(.2, .8, .2, 1), opacity .28s ease;\n}\n\n.controls[data-mode=\"other\"] .controls__button--skip,\n.controls[data-mode=\"other\"] .controls__button--shuffle,\n.controls[data-mode=\"other\"] .controls__button--repeat,\n.controls[data-mode=\"other\"] .controls__button--lyrics {\n  width: 0;\n  min-width: 0;\n  margin-left: 0;\n  opacity: 0;\n  pointer-events: none;\n}\n\n.controls__button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex: none;\n  width: 52px;\n  height: 52px;\n  padding: 0;\n  border: 0;\n  border-radius: 0;\n  /* theme-color-allow: icons sit on the dark cover shade in both host themes. */\n  background: transparent;\n  color: #fff;\n  cursor: pointer;\n  -webkit-tap-highlight-color: transparent;\n  transition: opacity .15s ease, transform .15s ease;\n}\n\n.controls__button svg {\n  width: 26px;\n  height: 26px;\n}\n\n.controls__button:hover {\n  opacity: .72;\n}\n\n.controls__button:active {\n  transform: scale(.94);\n}\n\n.controls__button:focus-visible {\n  outline: 2px solid #fff;\n  outline-offset: 2px;\n}\n\n.controls__button--primary {\n  width: 64px;\n  height: 64px;\n  background: transparent;\n  color: #fff;\n}\n\n.controls__button--primary svg {\n  width: 30px;\n  height: 30px;\n}\n\n.controls__button--primary:hover {\n  background: transparent;\n}\n\n.controls__button--lyrics[data-on=\"false\"],\n.controls__button--shuffle[data-on=\"false\"],\n.controls__button--repeat[data-on=\"false\"] {\n  opacity: .4;\n}\n\n.controls__glyph {\n  display: inline-flex;\n  line-height: 0;\n}\n\n/* Play / pause glyph swap, driven by data-state on .controls. */\n.controls[data-state=\"playing\"] [data-glyph=\"play\"],\n.controls[data-state=\"paused\"] [data-glyph=\"pause\"] {\n  display: none;\n}\n\n.controls[data-mode=\"other\"] .controls__button--primary [data-glyph=\"play\"] {\n  display: inline-flex;\n}\n\n.controls[data-mode=\"other\"] .controls__button--primary [data-glyph=\"pause\"] {\n  display: none;\n}\n\n/* Seek ---------------------------------------------------------------------------------------- */\n\n.controls__seek {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  width: 50%;\n  min-width: 0;\n}\n\n/* The clock belongs to the playing track; a card for another track has nothing to seek. */\n.controls[data-mode=\"other\"] .controls__seek {\n  display: none;\n}\n\n.controls__slider {\n  -webkit-appearance: none;\n  appearance: none;\n  flex: 1;\n  min-width: 0;\n  height: 16px;\n  margin: 0;\n  padding: 0;\n  border: 0;\n  border-radius: 0;\n  /* theme-color-allow: a thin white fill on the dark cover shade; the thumb is invisible. */\n  background: linear-gradient(90deg, #fff calc(var(--progress, 0) * 100%), rgb(255 255 255 / 28%) 0);\n  background-repeat: no-repeat;\n  background-size: 100% 2px;\n  background-position: 0 50%;\n  outline: none;\n  cursor: pointer;\n}\n\n.controls__slider:focus-visible {\n  box-shadow: 0 0 0 2px rgb(255 255 255 / 35%);\n}\n\n.controls__slider::-webkit-slider-runnable-track {\n  height: 16px;\n  background: transparent;\n}\n\n.controls__slider::-webkit-slider-thumb {\n  -webkit-appearance: none;\n  width: 12px;\n  height: 16px;\n  margin-top: 0;\n  border: 0;\n  border-radius: 0;\n  background: transparent;\n  box-shadow: none;\n}\n\n.controls__time {\n  flex: none;\n  font-size: 13px;\n  font-variant-numeric: tabular-nums;\n  color: rgb(255 255 255 / 85%);\n  white-space: nowrap;\n}\n\n/* Locate button (SPEC §2.5) ------------------------------------------------------------------- */\n\n/* Bottom-right corner; shown only while the playing track's expanded card is off screen. */\n.locate {\n  position: absolute;\n  right: 18px;\n  bottom: 18px;\n  z-index: 5;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 44px;\n  height: 44px;\n  padding: 0;\n  border: 1px solid color-mix(in srgb, var(--host-border) 60%, transparent);\n  border-radius: 50%;\n  background: color-mix(in srgb, var(--host-panel) 80%, transparent);\n  color: var(--host-text);\n  cursor: pointer;\n  backdrop-filter: blur(14px);\n  -webkit-tap-highlight-color: transparent;\n  transition: opacity .25s ease, transform .25s ease, background .15s ease, color .15s ease, visibility 0s linear 0s;\n}\n\n.locate svg {\n  width: 20px;\n  height: 20px;\n}\n\n.locate:hover {\n  background: color-mix(in srgb, var(--host-panel) 92%, var(--host-text));\n  color: var(--host-accent);\n}\n\n.locate:active {\n  transform: scale(.94);\n}\n\n.locate:focus-visible {\n  outline: 2px solid var(--host-accent);\n  outline-offset: 2px;\n}\n\n.locate[data-visible=\"false\"] {\n  opacity: 0;\n  visibility: hidden;\n  transform: translateY(6px);\n  pointer-events: none;\n  transition: opacity .25s ease, transform .25s ease, visibility 0s linear .25s;\n}\n\nbody[data-reduced-motion=\"true\"] .controls,\nbody[data-reduced-motion=\"true\"] .controls__button,\nbody[data-reduced-motion=\"true\"] .controls__button--skip,\nbody[data-reduced-motion=\"true\"] .controls__button--shuffle,\nbody[data-reduced-motion=\"true\"] .controls__button--repeat,\nbody[data-reduced-motion=\"true\"] .controls__button--lyrics,\nbody[data-reduced-motion=\"true\"] .controls__button--album,\nbody[data-reduced-motion=\"true\"] .controls__slider,\nbody[data-reduced-motion=\"true\"] .controls__slider::-webkit-slider-thumb,\nbody[data-reduced-motion=\"true\"] .locate {\n  transition: none;\n}\n\n/* 40-lyrics.css */\n/* Lyrics layer inside the expanded current-track card (SPEC §9). Mounted in `.poster__lyrics`\n   (`container-type: inline-size`), so cqw scales with the card width. Light text on the dark shade. */\n\n.lyrics {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  justify-content: flex-end;\n  gap: clamp(10px, 1.8cqw, 20px);\n  width: 100%;\n  height: 100%;\n  padding: 0;\n  box-sizing: border-box;\n  overflow: hidden;\n  color: var(--host-text, #fff);\n  font-family: system-ui, -apple-system, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n  text-align: left;\n  text-shadow: 0 2px 18px rgb(0 0 0 / 55%);\n  pointer-events: none;\n}\n\n/* Author `display: flex` would otherwise win over the UA `[hidden]` rule. */\n.lyrics[hidden] {\n  display: none;\n}\n\n.lyrics .sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n  border: 0;\n}\n\n.lyrics__line {\n  flex: 0 0 auto;\n  min-width: 0;\n  transform-origin: left center;\n  transition: transform .32s ease, opacity .32s ease, filter .32s ease;\n}\n\n.lyrics__line--current {\n  font-size: clamp(32px, 6.4cqw, 58px);\n  font-weight: 700;\n  opacity: 1;\n  transform: scale(1);\n}\n\n.lyrics__line--next {\n  font-size: clamp(22px, 4.4cqw, 40px);\n  font-weight: 600;\n  opacity: .5;\n  transform: scale(.8);\n  filter: blur(.6px);\n}\n\n.lyrics__text {\n  display: -webkit-box;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 3;\n  overflow: hidden;\n  line-height: 1.25;\n  overflow-wrap: anywhere;\n}\n\n.lyrics__line--next[hidden] {\n  display: none;\n}\n\n.lyrics__line--current .lyrics__text {\n  display: block;\n  overflow: visible;\n  -webkit-line-clamp: unset;\n  text-shadow: none;\n}\n\n.lyrics__translation {\n  display: none;\n  margin-top: .25em;\n  font-size: .62em;\n  font-weight: 500;\n  line-height: 1.3;\n  opacity: .68;\n}\n\n.lyrics[data-translation=\"true\"] .lyrics__translation:not(:empty) {\n  display: -webkit-box;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 2;\n  overflow: hidden;\n}\n\n/* Glow follows glyphs only: no filter / overflow clip, or the bloom becomes a rectangle. */\n.lyrics__word {\n  display: inline;\n  color: rgb(255 255 255 / 38%);\n  text-shadow: none;\n}\n\n.lyrics__word--sung {\n  color: rgb(255 255 255 / 94%);\n}\n\n.lyrics__word--active {\n  color: #fff;\n  text-shadow:\n    0 0 .04em rgb(255 255 255 / 70%),\n    0 0 .14em rgb(255 255 255 / 36%);\n}\n\n.lyrics__plain {\n  flex: 0 1 auto;\n  min-height: 0;\n  max-height: 100%;\n  overflow: auto;\n  overscroll-behavior: contain;\n  pointer-events: auto;\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n  font-size: clamp(22px, 3.6cqw, 32px);\n  line-height: 1.6;\n}\n\n.lyrics__plain::-webkit-scrollbar {\n  width: 6px;\n}\n\n.lyrics__plain::-webkit-scrollbar-thumb {\n  background: rgb(255 255 255 / 30%);\n  border-radius: 3px;\n}\n\n.lyrics__instrumental {\n  text-align: center;\n  font-size: clamp(28px, 5cqw, 46px);\n  font-weight: 600;\n  letter-spacing: .08em;\n  opacity: .85;\n}\n\n/* Light scheme: the layer still sits on the dark shade, so text stays light with a softer shadow. */\nhtml[data-color-scheme=\"light\"] .lyrics,\nbody[data-color-scheme=\"light\"] .lyrics {\n  color: rgb(255 255 255 / 96%);\n  text-shadow: 0 1px 10px rgb(0 0 0 / 40%);\n}\n\nhtml[data-color-scheme=\"light\"] .lyrics__line--current .lyrics__text,\nbody[data-color-scheme=\"light\"] .lyrics__line--current .lyrics__text {\n  text-shadow: none;\n}\n\n/* Reduced motion: no scale, blur or transitions; the whole current line stays highlighted. */\n.lyrics[data-reduced-motion=\"true\"] .lyrics__line,\nbody[data-reduced-motion=\"true\"] .lyrics .lyrics__line {\n  transform: none;\n  filter: none;\n  transition: none;\n}\n\n.lyrics[data-reduced-motion=\"true\"] .lyrics__line--next,\nbody[data-reduced-motion=\"true\"] .lyrics .lyrics__line--next {\n  opacity: .55;\n}\n\n.lyrics[data-reduced-motion=\"true\"] .lyrics__line--current .lyrics__text,\nbody[data-reduced-motion=\"true\"] .lyrics .lyrics__line--current .lyrics__text {\n  filter: none;\n}\n\n.lyrics[data-reduced-motion=\"true\"] .lyrics__word,\nbody[data-reduced-motion=\"true\"] .lyrics .lyrics__word {\n  color: rgb(255 255 255 / 88%);\n  text-shadow: none;\n}\n\n.lyrics[data-reduced-motion=\"true\"] .lyrics__word--active,\n.lyrics[data-reduced-motion=\"true\"] .lyrics__word--sung,\nbody[data-reduced-motion=\"true\"] .lyrics .lyrics__word--active,\nbody[data-reduced-motion=\"true\"] .lyrics .lyrics__word--sung {\n  color: #fff;\n}\n\n/* 50-states.css */\nbody[data-state='booting'] .field,\nbody[data-state='empty'] .field,\nbody[data-state='denied'] .field {\n  opacity: 0;\n  pointer-events: none;\n}\n\nbody[data-state='ready'] .field {\n  opacity: 1;\n  transition: opacity 0.35s ease;\n}\n\nbody[data-reduced-motion='true'][data-state='ready'] .field {\n  transition: none;\n}\n\n.state {\n  position: absolute;\n  inset: 0;\n  z-index: 6;\n  display: grid;\n  place-content: center;\n  justify-items: center;\n  gap: 10px;\n  padding: 32px;\n  text-align: center;\n  color: var(--host-text);\n  background: var(--host-app-bg);\n}\n\n.state[hidden] {\n  display: none;\n}\n\n.state__title {\n  margin: 0;\n  font-size: clamp(20px, 2.4vw, 28px);\n  font-weight: 700;\n  letter-spacing: -0.01em;\n}\n\n.state__body {\n  max-width: 460px;\n  margin: 0;\n  color: var(--host-muted);\n  font-size: 14px;\n  line-height: 1.6;\n}\n\n.state[data-state='denied'] .state__title::before {\n  content: '';\n  display: block;\n  width: 10px;\n  height: 10px;\n  margin: 0 auto 14px;\n  border-radius: 50%;\n  background: var(--host-accent);\n  box-shadow: 0 0 0 6px color-mix(in srgb, var(--host-accent) 22%, transparent);\n}\n\n.state[data-state='booting'] .state__title::before {\n  content: '';\n  display: block;\n  width: 18px;\n  height: 18px;\n  margin: 0 auto 14px;\n  border: 2px solid color-mix(in srgb, var(--host-accent) 30%, transparent);\n  border-top-color: var(--host-accent);\n  border-radius: 50%;\n  animation: state-spin 0.9s linear infinite;\n}\n\nbody[data-reduced-motion='true'] .state[data-state='booting'] .state__title::before {\n  animation: none;\n}\n\n@keyframes state-spin {\n  to { transform: rotate(360deg); }\n}\n\n.notice {\n  position: absolute;\n  left: 14px;\n  bottom: 14px;\n  z-index: 5;\n  padding: 5px 10px;\n  border: 1px solid color-mix(in srgb, var(--host-border) 60%, transparent);\n  border-radius: 999px;\n  color: var(--host-muted);\n  background: color-mix(in srgb, var(--host-panel) 82%, transparent);\n  font-size: 11px;\n  letter-spacing: 0.02em;\n  backdrop-filter: blur(12px);\n  pointer-events: none;\n}\n\n/* 60-albums.css */\n.album-tracks :focus-visible {\n  outline: 2px solid var(--host-accent);\n  outline-offset: 2px;\n}\n.poster__expanded--album {\n  --album-scale: 1;\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr) auto;\n  row-gap: calc(16px / var(--album-scale));\n}\n.poster__expanded--album .poster__meta {\n  order: unset;\n  margin-top: 0;\n  grid-row: 1;\n  pointer-events: auto;\n}\n.poster__expanded--album .poster__lyrics {\n  order: unset;\n  height: auto;\n  max-height: none;\n  min-height: 0;\n  overflow: visible;\n  grid-row: 2;\n}\n.poster__expanded--album .poster__controls {\n  order: unset;\n  grid-row: 3;\n}\n.poster__expanded--album .poster__title {\n  font-size: clamp(28px, 5.4cqw, 52px);\n  line-height: 1.15;\n  letter-spacing: -.02em;\n  -webkit-line-clamp: 2;\n}\n.poster__expanded--album .poster__artist {\n  font-size: clamp(14px, 2cqw, 20px);\n}\n.album-details { display: flex; flex-direction: column; height: 100%; min-height: 0; }\n.album-details[hidden],\n.album-actions[hidden] { display: none; }\n.album-details__message { margin: 0 0 calc(8px / var(--album-scale)); font-size: calc(12px / var(--album-scale)); color: rgb(255 255 255 / 75%); }\n.album-tracks {\n  --album-scroll-outset: max(0px, calc(var(--expanded-pad) - 12px / var(--album-scale)));\n  flex: 1;\n  min-height: 0;\n  margin-right: calc(-1 * var(--album-scroll-outset));\n  padding-right: var(--album-scroll-outset);\n  overflow: auto;\n  overflow-anchor: none;\n  overscroll-behavior: contain;\n  touch-action: pan-y;\n  scrollbar-gutter: stable;\n}\n/* theme-color-allow: a neutral thumb floats over cover artwork without a native dark track. */\n.album-tracks::-webkit-scrollbar { width: calc(8px / var(--album-scale)); height: calc(8px / var(--album-scale)); background: transparent; }\n.album-tracks::-webkit-scrollbar-track,\n.album-tracks::-webkit-scrollbar-corner { background: transparent; }\n.album-tracks::-webkit-scrollbar-track { margin-block: calc(24px / var(--album-scale)); }\n.album-tracks::-webkit-scrollbar-thumb {\n  /* A 4px visible stroke retains an 8px drag target. Insets also shorten its travel. */\n  border: calc(2px / var(--album-scale)) solid transparent;\n  background: rgb(255 255 255 / 45%);\n  background-clip: padding-box;\n  border-radius: 999px;\n}\n.album-tracks::-webkit-scrollbar-thumb:hover { background-color: rgb(255 255 255 / 65%); }\n.album-tracks::-webkit-scrollbar-button { display: none; width: 0; height: 0; }\n/* Fixed white ink belongs to the cover artwork's dark scrim in both host themes. */\n.album-track-row {\n  display: grid;\n  grid-template-columns: 2em minmax(0, 1fr) auto;\n  align-items: center;\n  gap: calc(12px / var(--album-scale));\n  width: 100%;\n  height: var(--album-track-height, calc(44px / var(--album-scale)));\n  padding: calc(8px / var(--album-scale));\n  border: 0;\n  border-bottom: 1px solid rgb(255 255 255 / 12%);\n  text-align: left;\n  background: transparent;\n  color: #fff;\n  font: inherit;\n  font-size: calc(15px / var(--album-scale));\n  cursor: pointer;\n}\n.album-tracks__placeholder { display: flex; color: rgb(255 255 255 / 72%); font-size: calc(13px / var(--album-scale)); }\n.album-tracks__placeholder:not(button) { cursor: default; }\n.album-tracks button:hover, .album-tracks button[aria-current=\"true\"] { background: rgb(255 255 255 / 18%); }\n.album-tracks button[aria-current=\"true\"] { box-shadow: inset 3px 0 var(--host-accent); }\n.album-tracks button:disabled { opacity: .5; cursor: default; }\n.album-track__title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.album-track__number, .album-track__time { color: rgb(255 255 255 / 72%); font-variant-numeric: tabular-nums; font-size: .9em; }\n\n.controls.album-actions[data-mode=\"other\"] .controls__button--primary {\n  overflow: hidden;\n  width: 0;\n  min-width: 0;\n  margin-left: 0;\n  opacity: 0;\n  pointer-events: none;\n}\n.controls.album-actions[data-mode=\"other\"] .controls__button--album {\n  width: 64px;\n  height: 64px;\n}\n.controls.album-actions[data-mode=\"other\"] .controls__button--album svg {\n  width: 30px;\n  height: 30px;\n}\n\n/* 65-control-panel.css */\n.control-panel {\n  position: fixed;\n  inset: min(10vh, 80px) 0 auto;\n  margin: 0 auto;\n  width: min(640px, calc(100% - 32px));\n  max-height: calc(100dvh - 32px);\n  box-sizing: border-box;\n  padding: 20px;\n  overflow: auto;\n  border: 1px solid var(--host-border);\n  background: var(--host-panel);\n  color: var(--host-text);\n  border-radius: 16px;\n}\n\n.control-panel:not([open]) { display: none; }\n.control-panel::backdrop { background: color-mix(in srgb, var(--host-app-bg) 65%, transparent); }\n\n.control-panel__form { display: flex; flex-direction: column; gap: 18px; }\n.control-panel__header { display: flex; align-items: center; justify-content: space-between; gap: 16px; }\n.control-panel__header h2 { margin: 0; font-size: 18px; font-weight: 650; }\n.control-panel__section { display: flex; flex-direction: column; gap: 10px; }\n.control-panel [hidden] { display: none; }\n.control-panel__label {\n  margin: 0;\n  font-size: 12px;\n  font-weight: 650;\n  letter-spacing: .04em;\n  color: var(--host-muted);\n}\n.control-panel__hint { margin: 0; font-size: 12px; color: var(--host-muted); }\n.control-panel__options,\n.control-panel__pager,\n.control-panel__row { display: flex; align-items: center; gap: 8px; }\n.control-panel__options { flex-wrap: wrap; }\n.control-panel__status {\n  flex: 1;\n  min-width: 0;\n  font-size: 12px;\n  text-align: center;\n  font-variant-numeric: tabular-nums;\n}\n.control-panel__field-label { font-size: 13px; color: var(--host-muted); white-space: nowrap; }\n.control-panel__options.is-disabled,\n.control-panel__row.is-disabled { opacity: .45; }\n\n.control-panel input,\n.control-panel select {\n  min-width: 0;\n  width: 100%;\n  min-height: 44px;\n  padding: 0 12px;\n  border: 1px solid var(--host-border);\n  border-radius: 6px;\n  background: var(--host-app-bg);\n  color: var(--host-text);\n  font: inherit;\n}\n\n.control-panel input[type=\"search\"] { min-height: 52px; }\n.control-panel input::placeholder { color: var(--host-muted); }\n.control-panel input[type=\"color\"] {\n  width: 52px;\n  min-width: 52px;\n  padding: 4px;\n  cursor: pointer;\n}\n.control-panel input[type=\"range\"] {\n  flex: 1;\n  padding: 0;\n  min-height: 44px;\n  accent-color: var(--host-accent);\n}\n.control-panel input[type=\"color\"]:disabled,\n.control-panel input[type=\"range\"]:disabled { cursor: default; }\n\n.control-panel button {\n  min-height: 44px;\n  padding: 6px 12px;\n  border: 1px solid var(--host-border);\n  border-radius: 6px;\n  background: var(--host-panel);\n  color: var(--host-text);\n  font: inherit;\n  white-space: nowrap;\n  cursor: pointer;\n  transition: background .18s ease, border-color .18s ease;\n}\n\n.control-panel button:hover { background: var(--host-app-bg); }\n.control-panel button:disabled { opacity: .45; cursor: default; }\n.control-panel button[aria-pressed=\"true\"] {\n  background: color-mix(in srgb, var(--host-accent) 22%, var(--host-panel));\n  border-color: color-mix(in srgb, var(--host-accent) 55%, var(--host-border));\n}\n\n.control-panel :focus-visible {\n  outline: 2px solid var(--host-accent);\n  outline-offset: 2px;\n}\n\n@media (max-width: 480px) {\n  .control-panel { inset-block-start: 16px; padding: 16px; }\n  .control-panel__pager,\n  .control-panel__row { flex-wrap: wrap; }\n  .control-panel__status { order: -1; flex-basis: 100%; }\n  .control-panel__pager button { flex: 1; }\n}\n\nbody[data-reduced-motion=\"true\"] .control-panel button { transition: none; }\n"
