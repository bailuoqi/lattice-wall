      "path": "panel.html",
      "content": "<!doctype html>\n<html lang=\"zh-CN\" data-color-scheme=\"dark\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Lattice · 曲库拼贴墙</title>\n  <link rel=\"stylesheet\" href=\"panel.css\">\n</head>\n<body data-state=\"booting\">\n  <main class=\"lattice\" id=\"lattice\">\n    <div class=\"field\" id=\"field\" tabindex=\"0\" role=\"application\" aria-label=\"曲库拼贴墙，Ctrl + Space 打开功能面板\" aria-keyshortcuts=\"Control+Space\">\n      <div class=\"world\" id=\"world\"></div>\n      <div class=\"field__vignette\" aria-hidden=\"true\"></div>\n    </div>\n    <button class=\"locate\" id=\"locate\" type=\"button\" data-visible=\"false\" aria-label=\"定位到正在播放的歌曲\" title=\"定位到正在播放的歌曲 (C)\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\" focusable=\"false\">\n        <circle cx=\"12\" cy=\"12\" r=\"6.5\"/>\n        <circle cx=\"12\" cy=\"12\" r=\"2\" fill=\"currentColor\" stroke=\"none\"/>\n        <path d=\"M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3\"/>\n      </svg>\n    </button>\n    <section class=\"state\" id=\"state\" role=\"status\" aria-live=\"polite\" hidden></section>\n  </main>\n  <script src=\"__bridge__.js\"></script>\n  <script src=\"panel.js\"></script>\n</body>\n</html>\n"
