{
  "type": "echo-plugin-package",
  "version": 1,
  "exportedAt": "2026-09-08T02:07:07.341Z",
  "manifest": {
    "id": "echo.lattice-wall",
    "name": "Lattice · 音乐拼贴墙",
    "version": "1.1.0",
    "apiVersion": 2,
    "entry": "plugin.js",
    "permissions": [
      "playback:read",
      "playback:control",
      "queue:read",
      "queue:control",
      "lyrics:read",
      "fs:plugin",
      "library:read"
    ],
    "contributes": {
      "commands": [
        {
          "id": "open-lattice",
          "title": "Lattice · 音乐拼贴墙"
        }
      ],
      "playerBarActions": [
        {
          "id": "open-lattice",
          "title": "Lattice · 音乐拼贴墙",
          "description": "打开曲库或专辑拼贴墙",
          "commandId": "open-lattice",
          "icon": "blocks"
        }
      ],
      "panels": [
        {
          "id": "wall",
          "title": "Lattice · 曲库拼贴墙",
          "path": "panel.html",
          "placement": "main"
        },
        {
          "id": "albums",
          "title": "Lattice · 专辑拼贴墙",
          "path": "albums.html",
          "placement": "main"
        }
      ],
      "settings": [
        {
          "id": "immersive",
          "title": "打开时全屏沉浸",
          "description": "进入拼贴墙时铺满 ECHO 窗口；旧版宿主自动回退为大面板。",
          "type": "boolean",
          "defaultValue": true
        },
        {
          "id": "auto-focus",
          "title": "切歌自动聚焦",
          "description": "当前曲变化时飞到最近的当前曲卡片并展开。",
          "type": "boolean",
          "defaultValue": true
        },
        {
          "id": "lighting-mode",
          "title": "封面灯光",
          "description": "聚光灯保留暗角与未选中封面阴影；白天模式下所有封面一样亮。",
          "type": "select",
          "defaultValue": "spotlight",
          "options": [
            {
              "label": "聚光灯",
              "value": "spotlight"
            },
            {
              "label": "白天",
              "value": "daytime"
            }
          ]
        },
        {
          "id": "vignette",
          "title": "暗角",
          "description": "在整面墙四周叠加暗角。",
          "type": "boolean",
          "defaultValue": true
        },
        {
          "id": "lights-out",
          "title": "关灯",
          "description": "压暗所有非当前曲卡片。",
          "type": "boolean",
          "defaultValue": false
        },
        {
          "id": "poster-tint",
          "title": "非活动海报叠色",
          "description": "给非播放的专辑和歌曲封面添加黑色阴影。",
          "type": "boolean",
          "defaultValue": true
        },
        {
          "id": "poster-tint-custom",
          "title": "使用自定义叠色",
          "description": "关闭时统一使用纯黑阴影。",
          "type": "boolean",
          "defaultValue": false
        },
        {
          "id": "poster-tint-color",
          "title": "自定义叠色",
          "type": "color",
          "defaultValue": "#000000"
        },
        {
          "id": "poster-tint-intensity",
          "title": "叠色强度",
          "type": "range",
          "defaultValue": 0.5,
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        {
          "id": "cell-size",
          "title": "格子尺寸",
          "type": "select",
          "defaultValue": "M",
          "options": [
            {
              "label": "小",
              "value": "S"
            },
            {
              "label": "中",
              "value": "M"
            },
            {
              "label": "大",
              "value": "L"
            }
          ]
        },
        {
          "id": "show-lyrics",
          "title": "当前曲歌词",
          "description": "展开当前曲时显示逐字歌词。",
          "type": "boolean",
          "defaultValue": true
        },
        {
          "id": "show-translation",
          "title": "翻译行",
          "type": "boolean",
          "defaultValue": true
        },
        {
          "id": "ui-font",
          "title": "界面字体",
          "description": "拼贴墙界面使用的字体族。留空则跟随系统。",
          "type": "string",
          "defaultValue": "",
          "placeholder": "例如 Microsoft YaHei"
        }
      ]
    }
  },
  "files": [
    {
      "path": "albums.html",
      "content": "<!doctype html>\n<html lang=\"zh-CN\" data-color-scheme=\"dark\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Lattice · 专辑拼贴墙</title>\n  <link rel=\"stylesheet\" href=\"panel.css\">\n</head>\n<body data-state=\"booting\">\n  <main class=\"lattice\" id=\"lattice\">\n    <div class=\"field\" id=\"field\" tabindex=\"0\" role=\"application\" aria-label=\"专辑拼贴墙，Ctrl + Space 打开功能面板\" aria-keyshortcuts=\"Control+Space\">\n      <div class=\"world\" id=\"world\"></div>\n      <div class=\"field__vignette\" aria-hidden=\"true\"></div>\n    </div>\n    <button class=\"locate\" id=\"locate\" type=\"button\" data-visible=\"false\" aria-label=\"定位到正在播放的专辑（当前页）\" title=\"定位到正在播放的专辑（当前页） (C)\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\" focusable=\"false\">\n        <circle cx=\"12\" cy=\"12\" r=\"6.5\"/>\n        <circle cx=\"12\" cy=\"12\" r=\"2\" fill=\"currentColor\" stroke=\"none\"/>\n        <path d=\"M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3\"/>\n      </svg>\n    </button>\n    <section class=\"state\" id=\"state\" role=\"status\" aria-live=\"polite\" hidden></section>\n  </main>\n  <script src=\"__bridge__.js\"></script>\n  <script src=\"albums.js\"></script>\n</body>\n</html>\n"
    },
