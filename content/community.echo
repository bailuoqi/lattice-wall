,G.dispose(),u.dispose(),g=[],f=[]}};return window.addEventListener(\"pagehide\",Me,{once:!0}),t?.addEventListener(\"abort\",Me,{once:!0}),t?.aborted&&Me(),Me}var zr=e=>({...e,...typeof e.playback.getRate==\"function\"&&typeof e.playback.setRate==\"function\"?{speed:{get:()=>e.playback.getRate(),set:t=>e.playback.setRate(t),onChanged:t=>e.events.on(\"playback:status\",o=>{let r=o&&typeof o==\"object\"?o.playbackRate:void 0;typeof r==\"number\"&&Number.isFinite(r)&&t(r)})}}:{},...e.window&&typeof e.window.getDesktopWall==\"function\"?{desktop:{get:()=>e.window.getDesktopWall(),set:t=>e.window.setDesktopWall(t)}}:{}});var no=(e,t)=>`\n<main class=\"lattice\" id=\"lattice\">\n  <div class=\"field\" id=\"field\" tabindex=\"0\" role=\"application\" aria-label=\"${e}\">\n    <div class=\"world\" id=\"world\"></div>\n    <div class=\"field__vignette\" aria-hidden=\"true\"></div>\n  </div>\n  <button class=\"locate\" id=\"locate\" type=\"button\" data-visible=\"false\" aria-label=\"${t}\" title=\"${t}\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\" focusable=\"false\">\n      <circle cx=\"12\" cy=\"12\" r=\"6.5\"></circle>\n      <circle cx=\"12\" cy=\"12\" r=\"2\" fill=\"currentColor\" stroke=\"none\"></circle>\n      <path d=\"M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3\"></path>\n    </svg>\n  </button>\n  <section class=\"state\" id=\"state\" role=\"status\" aria-live=\"polite\" hidden></section>\n</main>`;var Ws=document.querySelector(\".lattice-wall-host\"),Vs=zr(echo),Gr=null,oo=null,Mn=null,_n=!1;async function qr(e){if(_n)return;let t=e.panel?.id===\"albums\"?\"albums\":\"library\";if(document.body.dataset.desktopWall=String(!!e.desktop),document.body.style.setProperty(\"--desktop-wall-bottom-inset\",String(e.desktop?.bottomInset??0)+\"px\"),t===Gr)return;Gr=t,oo?.abort(),Mn?.(),Mn=null;let o=new AbortController;oo=o,document.body.dataset.state=\"booting\";let r=document.createElement(\"div\");r.className=\"lattice-wall\",r.innerHTML=t===\"albums\"?no(\"专辑拼贴墙\",\"定位到正在播放的专辑\"):no(\"曲库拼贴墙\",\"定位到正在播放的歌曲\"),Ws.replaceChildren(r);try{let n=await(t===\"albums\"?$r:Ir)(Vs,o.signal);_n||o.signal.aborted?n():(Mn=n,parent.postMessage({channel:\"echo:workshop-plugin\",version:1,type:\"desktop-mounted\"},\"*\"))}catch{if(!_n&&!o.signal.aborted){document.body.dataset.state=\"error\";let n=r.querySelector(\"#state\");n&&(n.hidden=!1,n.textContent=\"桌面拼贴墙加载失败，请关闭后重试。\")}}}var $s=echo.ui.onContextChanged(e=>{qr(e)});echo.ui.getContext().then(e=>qr(e));window.addEventListener(\"pagehide\",()=>{_n=!0,$s(),oo?.abort(),Mn?.()},{once:!0});})();\n"
    },
    {
      "path": "panel.css",
      "content": "/*! Lattice Wall | Copyright (c) 2026 Lattice Wall contributors\n * SPDX-License-Identifier: AGPL-3.0-only\n * See LICENSE and NOTICE.md in the Workshop item for license and source information.\n */\n\n/* 00-base.css */\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\n/* Fallbacks only: main.ts writes the live host appearance tokens inline on <html>. */\n:root {\n  color-scheme: dark;\n  --host-accent: #6678ff;\n  --host-accent-text: #ffffff;\n  --host-app-bg: #0f1116;\n  --host-text: #f2f4f8;\n  --host-muted: #9aa3b5;\n  --host-panel: #171a22;\n  --host-border: #2a2f3b;\n  --host-player: #171a22;\n  --host-accent-2: color-mix(in srgb, var(--host-accent) 45%, var(--host-text));\n  --shade-color: #000000;\n  --wall-background: #000000;\n  --wall-text: #ffffff;\n  --wall-muted: rgb(255 255 255 / 72%);\n}\n\nhtml[data-color-scheme=\"light\"] {\n  color-scheme: light;\n  --host-app-bg: #f3f4f8;\n  --host-text: #15181f;\n  --host-muted: #5f6777;\n  --host-panel: #ffffff;\n  --host-border: #d7dbe4;\n  --host-player: #ffffff;\n}\n\nhtml,\nbody {\n  margin: 0;\n  height: 100%;\n  overflow: hidden;\n}\n\nbody {\n  font-family: var(--ui-font, system-ui, -apple-system, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif);\n  color: var(--host-text);\n  background: var(--wall-background);\n  -webkit-font-smoothing: antialiased;\n}\n\n/* Transparent from the first frame, before the bridge or library has finished booting. */\nhtml:has(body[data-opening=\"true\"]) {\n  color-scheme: normal;\n  background: transparent;\n}\n\nbody[data-opening=\"true\"] {\n  background: transparent;\n}\n\n:focus-visible {\n  outline: 2px solid var(--host-accent);\n  outline-offset: 2px;\n}\n\n.sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  border: 0;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n}\n\nbody[data-reduced-motion=\"true\"] .field__vignette,\nbody[data-reduced-motion=\"true\"] .world {\n  transition: none;\n}\n\n/* 10-wall.css */\n.lattice{\n  position: fixed;\n  inset: 0;\n  overflow: hidden;\n}\n\n.field{\n  position: absolute;\n  inset: 0;\n  /* The camera owns movement; focusing controls must never scroll this canvas. */\n  overflow: clip;\n  touch-action: none;\n  user-select: none;\n  -webkit-user-select: none;\n  cursor: grab;\n  outline: none;\n  isolation: isolate;\n  background: var(--wall-background);\n}\n\n/* Unfilled areas reveal the actual previous ECHO page, not a substitute colour. */\nbody[data-opening=\"true\"] .field{ background: transparent; }\n\nbody[data-dragging=\"true\"] .field{\n  cursor: grabbing;\n}\n\n/* Paint the focus outline above the poster cards. */\n.field:focus-visible{\n  outline: 2px solid color-mix(in srgb, var(--host-accent) 55%, transparent);\n  outline-offset: -2px;\n}\n\n.world{\n  position: absolute;\n  left: 0;\n  top: 0;\n  width: 0;\n  height: 0;\n  transform-origin: 0 0;\n  will-change: transform;\n  z-index: 1;\n}\n\n.wall-depth-scene{\n  position: absolute;\n  inset: 0;\n  transform-origin: 50% 50%;\n  --depth-x: 0;\n  --depth-y: 0;\n  --depth-amount: 0;\n}\n.wall-depth-scene[data-depth-active=\"true\"]::after{\n  content: '';\n  position: absolute;\n  inset: 0;\n  z-index: 2;\n  pointer-events: none;\n  opacity: calc(var(--depth-amount) * .34);\n  background: radial-gradient(ellipse 80% 75% at calc(50% + var(--depth-x) * 30%) calc(50% + var(--depth-y) * 30%), rgb(255 255 255 / 18%), transparent 70%);\n  mix-blend-mode: screen;\n}\n/* Project the shared wall plane after flattening its native UI layers. Keeping a 3D context\n   here lets the full-size scene hit plane occlude controls on the tilted-away half. The scene\n   matrix still supplies perspective; foreground depth comes from the per-layer XY parallax. */\n\n.fisheye-surface{\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  pointer-events: none;\n  z-index: 0;\n}\n.fisheye-surface[hidden]{ display: none; }\n\n.field__vignette{\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  z-index: 2;\n  opacity: 0;\n  transition: opacity 0.3s;\n  background: radial-gradient(ellipse at center, transparent 46%, rgb(0 0 0 / 74%) 100%);\n}\n\nbody[data-vignette=\"true\"] .field__vignette{\n  opacity: 1;\n}\n\nbody[data-lighting=\"daytime\"] .field__vignette{\n  opacity: 0;\n}\n\nhtml[data-color-scheme=\"light\"] .field__vignette{\n  background: radial-gradient(ellipse at center, transparent 46%, rgb(0 0 0 / 48%) 100%);\n}\n\nbody[data-opening=\"true\"] .field__vignette,\nbody[data-opening=\"true\"] .wall-depth-scene::after{ opacity: 0; transition: none; }\n\n/* 20-poster.css */\n/* Poster cards. Position and size come from inline `transform` / `width` / `height` written by\n   posterWall.ts; nothing below may set `transform` on `.poster` itself. */\n\n.poster{\n  --expanded-pad: clamp(18px, 4.5%, 40px);\n  position: absolute;\n  left: 0;\n  top: 0;\n  transform-origin: 0 0;\n  box-sizing: border-box;\n  border-radius: 0;\n  overflow: hidden;\n  contain: layout paint;\n  background: var(--host-panel);\n  color: #fff;\n  cursor: pointer;\n  user-select: none;\n  -webkit-tap-highlight-color: transparent;\n}\n\n.world[data-fisheye-surface=\"true\"] .poster{\n  background: transparent;\n  /* UI units follow the curved cover beyond the card's straight four-corner outline. */\n  overflow: visible;\n  contain: layout;\n}\n.world[data-fisheye-surface=\"true\"] .poster__body{ visibility: hidden; }\n\n.poster__meta,\n.poster__lyrics,\n.poster__controls,\n.poster__caption{ transform-origin: 0 0; }\n\n/* Covers stay borderless when focused or expanded. */\n.poster:focus-visible{\n  outline: none;\n}\n\n.poster[data-expanded=\"true\"] {\n  /* Keep the mounted node in place: re-appending it cancels its lighting transitions. */\n  z-index: 10;\n  cursor: default;\n}\n\n/* Layers ------------------------------------------------------------------------------------- */\n\n.poster__body{\n  position: absolute;\n  inset: 0;\n  transform-origin: center;\n  transition: transform .28s cubic-bezier(.2, .8, .2, 1), filter .28s ease;\n}\n\n/* Scale follows pointer or keyboard focus. Lighting is only hover / playing / expanded. */\n.poster:hover .poster__body,\n.poster[data-focused=\"true\"] .poster__body{\n  transform: scale(var(--hx, 1.06), var(--hy, 1.06));\n}\n\n.poster:hover .poster__body{\n  filter: saturate(1.22) brightness(1.16);\n}\n\nbody[data-dragging=\"true\"] .poster .poster__body{\n  transform: none;\n  filter: none;\n}\n\n.poster[data-expanded=\"true\"] .poster__body{\n  transform: none;\n  filter: brightness(1.18) saturate(1.12);\n}\n\n.poster__fallback{\n  position: absolute;\n  inset: 0;\n}\n\n.poster__art{\n  position: absolute;\n  inset: 0;\n  transform-origin: center;\n}\n.world[data-depth=\"true\"] .poster__art{\n  transform: translate(calc(var(--depth-x) * var(--depth-amount) * var(--depth-art-shift)), calc(var(--depth-y) * var(--depth-amount) * var(--depth-art-shift))) scale(calc(1 + var(--depth-amount) * var(--depth-art-scale)));\n}\n\n.poster__cover{\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  display: block;\n  object-fit: cover;\n  -webkit-user-drag: none;\n}\n\n/* Local album thumbs are centre-cropped squares; preserve that framing in the large variant. */\n.poster[data-square-cover=\"true\"] .poster__cover{\n  inset: auto;\n  left: 50%;\n  top: 50%;\n  width: var(--cover-side, 100%);\n  height: var(--cover-side, 100%);\n  transform: translate(-50%, -50%);\n}\n\n.poster__cover[hidden] {\n  display: none;\n}\n\n.poster__shade{\n  position: absolute;\n  inset: 0;\n  /* Keep the expanded gradient stable; idle covers use their separately configured tint. */\n  background:\n    linear-gradient(180deg, transparent 14%, color-mix(in srgb, var(--shade-color, #000) 48%, transparent) 56%, color-mix(in srgb, var(--shade-color, #000) 94%, transparent) 100%),\n    linear-gradient(90deg, color-mix(in srgb, var(--shade-color, #000) 76%, transparent), transparent 58%),\n    radial-gradient(85% 75% at 0% 100%, color-mix(in srgb, var(--shade-color, #000) 58%, transparent), transparent 72%);\n  opacity: 0;\n  transition: opacity .3s ease;\n}\n\n.poster[data-expanded=\"true\"] .poster__shade{\n  opacity: 1;\n}\n\n.poster__tint{\n  position: absolute;\n  inset: 0;\n  /* theme-color-allow: neutral cover shading must stay black in every host theme. */\n  --tint-fill: color-mix(in srgb, var(--tint-color, #000) calc(var(--tint-alpha, .5) * 100%), transparent);\n  background: var(--tint-fill);\n  opacity: 0;\n  transition: opacity .3s ease;\n}\n\n.world[data-tint-gradient=\"diagonal\"] .poster__tint{\n  /* Gradients add depth above the uniform base. Alpha belongs to each paint layer so the\n     base does not flatten gradients of the same colour; opacity only controls focus fading. */\n  background:\n    linear-gradient(180deg, transparent 38%, color-mix(in srgb, var(--tint-fill) 74%, transparent) 100%),\n    linear-gradient(90deg, color-mix(in srgb, var(--tint-fill) 46%, transparent), transparent 40%),\n    var(--tint-fill);\n}\n\n.world[data-tint-gradient=\"vertical\"] .poster__tint{\n  background:\n    linear-gradient(180deg, transparent 38%, color-mix(in srgb, var(--tint-fill) 74%, transparent) 100%),\n    var(--tint-fill);\n}\n\n.world[data-tint=\"true\"] .poster:not([data-current=\"true\"]):not([data-expanded=\"true\"]):not(:hover) .poster__tint{\n  opacity: 1;\n}\n\nbody[data-dragging=\"true\"] .world[data-tint=\"true\"] .poster:not([data-current=\"true\"]):not([data-expanded=\"true\"]) .poster__tint{\n  opacity: 1;\n}\n\n.poster__lights{\n  position: absolute;\n  inset: 0;\n  background: #000;\n  opacity: 0;\n  transition: opacity .3s ease;\n}\n\n.world[data-lights-out=\"true\"] .poster:not([data-current=\"true\"]):not([data-expanded=\"true\"]):not(:hover) .poster__lights{\n  opacity: .72;\n}\n\nbody[data-dragging=\"true\"] .world[data-lights-out=\"true\"] .poster:not([data-current=\"true\"]):not([data-expanded=\"true\"]) .poster__lights{\n  opacity: .72;\n}\n\n/* An open card is the only bright one; other current-track copies dim with the rest. */\n.world:has(> .poster[data-expanded=\"true\"]) .poster:not([data-expanded=\"true\"]) .poster__lights{\n  opacity: .34;\n}\n\n.world[data-lights-out=\"true\"]:has(> .poster[data-expanded=\"true\"]) .poster:not([data-expanded=\"true\"]) .poster__lights{\n  opacity: .8;\n}\n\n/* Daytime: idle covers stay equally bright. Expanded cards keep their own scrim for type. */\nbody[data-lighting=\"daytime\"] .poster:not([data-expanded=\"true\"]) .poster__shade,\nbody[data-lighting=\"daytime\"] .poster:not([data-expanded=\"true\"]) .poster__tint,\nbody[data-lighting=\"daytime\"] .poster:not([data-expanded=\"true\"]) .poster__lights,\nbody[data-lighting=\"daytime\"] .world:has(> .poster[data-expanded=\"true\"]) .poster:not([data-expanded=\"true\"]) .poster__lights{\n  opacity: 0;\n}\n\n/* Expanded card content ---------------------------------------------------------------------- */\n\n@property --lyrics-open {\n  syntax: '<number>';\n  inherits: true;\n  initial-value: 0;\n}\n\n@property --lyrics-open-height {\n  syntax: '<length>';\n  inherits: true;\n  initial-value: 0px;\n}\n\n.poster__expanded{\n  position: absolute;\n  inset: 0;\n  z-index: 2;\n  display: flex;\n  flex-direction: column;\n  row-gap: 12px;\n  box-sizing: border-box;\n  padding: var(--expanded-pad);\n  opacity: 0;\n  transition: opacity .18s ease;\n}\n\n.poster[data-expanded=\"true\"][data-settled=\"true\"] .poster__expanded{\n  opacity: 1;\n}\n\n.poster__meta{\n  order: 1;\n  margin-top: auto;\n  flex: none;\n  min-width: 0;\n  pointer-events: none;\n  container-type: inline-size;\n}\n\n.poster__title{\n  margin: 0;\n  width: 100%;\n  font-weight: 700;\n  font-size: clamp(56px, 10.5cqw, 96px);\n  line-height: 1.15;\n  font-family: system-ui, -apple-system, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n  letter-spacing: -.02em;\n  text-shadow: 0 2px 14px rgb(0 0 0 / 42%);\n  overflow-wrap: break-word;\n  overflow: visible;\n  padding-inline-end: .04em;\n}\n\n.poster__title-text{\n  display: block;\n  transform-origin: top left;\n  transform: scale(var(--title-scale));\n  /* Stable text raster and line breaks; the parent reserves the actual scaled height. */\n  will-change: transform;\n}\n\n.poster__artist{\n  margin: .35em 0 0;\n  font-size: clamp(16px, 2.2cqw, 24px);\n  line-height: 1.3;\n  color: rgb(255 255 255 / 82%);\n  text-shadow: 0 2px 14px rgb(0 0 0 / 50%);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.poster__artist:empty{\n  display: none;\n}\n\n.poster__lyrics{\n  order: 2;\n  position: relative;\n  flex: 0 0 auto;\n  max-height: 0;\n  min-height: 0;\n  overflow: hidden;\n  /* inline-size only: `size` containment makes auto height ignore children, so the slot stays 0. */\n  container-type: inline-size;\n  /* One inherited progress value drives both directions, including interruptions. */\n}\n\n.poster__lyrics .lyrics{\n  height: auto;\n  overflow: visible;\n  justify-content: flex-start;\n}\n\n/* Taps on the empty controls row (or on a hidden cluster) fall through to the card. */\n.poster__controls{\n  order: 3;\n  flex: none;\n  pointer-events: none;\n}\n\n.poster__controls > *{\n  pointer-events: auto;\n}\n\n/* The queue wall owns this motion; album cards retain their existing layout. */\n.poster__expanded:not(.poster__expanded--album) {\n  flex-direction: column-reverse;\n}\n\n.poster__expanded:not(.poster__expanded--album) .poster__meta{\n  order: 3;\n  margin-top: 0;\n}\n\n.poster__expanded:not(.poster__expanded--album) .poster__controls{\n  order: 1;\n}\n\n.poster__expanded:not(.poster__expanded--album) .poster__title{\n  --title-scale: calc(1 - var(--lyrics-open) * (1 - var(--title-open-scale, 1)));\n  height: calc(var(--title-natural-height) * var(--title-scale));\n}\n\n.poster__expanded:not(.poster__expanded--album) .poster__lyrics{\n  max-height: none;\n  height: calc(var(--lyrics-open-height, 0px) * var(--lyrics-open));\n}\n\n.poster__expanded:not(.poster__expanded--album) .lyrics{\n  transform: translateZ(0);\n  opacity: var(--lyrics-open);\n}\n\n.poster__expanded:not(.poster__expanded--album) .poster__artist{\n  transform: translateZ(0);\n}\n\n/* App entry: each tile appears in place, black first, then quickly uncovers its artwork. */\n\n.poster--enter{\n  animation: poster-enter .2s linear both;\n  animation-delay: var(--enter-delay, 0s);\n}\n\n.poster--enter::after{\n  content: '';\n  position: absolute;\n  inset: 0;\n  z-index: 20;\n  background: #000;\n  pointer-events: none;\n  animation: poster-enter-black .2s both;\n  animation-delay: var(--enter-delay, 0s);\n}\n\n.poster.poster--enter .poster__body{ transform: none; transition: none; }\n\n.world[data-fisheye-surface=\"true\"] .poster--enter::after{ display: none; }\n\n.poster--enter > .poster__expanded,\n.poster--enter > .poster__caption{\n  animation: poster-enter-content .2s both;\n  animation-delay: var(--enter-delay, 0s);\n}\n\n.poster--fade .poster__body{\n  animation: poster-fade .12s ease-out both;\n}\n\n@keyframes poster-enter {\n  0% { opacity: 0; }\n  .01%, 100% { opacity: 1; }\n}\n\n/* 40 ms of solid black, followed by a 160 ms ease-out reveal (coverMotion.ts). */\n@keyframes poster-enter-black {\n  0%, 20% { opacity: 1; animation-timing-function: ease-out; }\n  100% { opacity: 0; }\n}\n\n@keyframes poster-enter-content {\n  0%, 20% { opacity: 0; animation-timing-function: ease-out; }\n  100% { opacity: 1; }\n}\n\n@keyframes poster-fade {\n  from {\n    opacity: 0;\n  }\n\n  to {\n    opacity: 1;\n  }\n}\n\n/* Reduced motion: no hover scale, no entrance, no springs (JS snaps), keep the hover filter ----- */\n\n.world[data-reduced-motion=\"true\"] .poster,\nbody[data-reduced-motion=\"true\"] .poster{\n  transition: none;\n  animation: none;\n}\n\n.world[data-reduced-motion=\"true\"] .poster .poster__body,\nbody[data-reduced-motion=\"true\"] .poster .poster__body{\n  transform: none;\n  transition: none;\n  animation: none;\n}\n\n.world[data-reduced-motion=\"true\"] .poster .poster__expanded,\nbody[data-reduced-motion=\"true\"] .poster .poster__expanded,\n.world[data-reduced-motion=\"true\"] .poster .poster__meta,\nbody[data-reduced-motion=\"true\"] .poster .poster__meta,\n.world[data-reduced-motion=\"true\"] .poster .poster__title,\nbody[data-reduced-motion=\"true\"] .poster .poster__title,\n.world[data-reduced-motion=\"true\"] .poster .poster__lyrics,\nbody[data-reduced-motion=\"true\"] .poster .poster__lyrics,\n.world[data-reduced-motion=\"true\"] .poster .poster__shade,\nbody[data-reduced-motion=\"true\"] .poster .poster__shade,\n.world[data-reduced-motion=\"true\"] .poster .poster__tint,\nbody[data-reduced-motion=\"true\"] .poster .poster__tint,\n.world[data-reduced-motion=\"true\"] .poster .poster__lights,\nbody[data-reduced-motion=\"true\"] .poster .poster__lights{\n  transition: none;\n  animation: none;\n}\n\n.world[data-reduced-motion=\"true\"] .poster--enter::after,\nbody[data-reduced-motion=\"true\"] .poster--enter::after{ display: none; }\n\n.world[data-reduced-motion=\"true\"] .poster .poster__caption,\nbody[data-reduced-motion=\"true\"] .poster .poster__caption{ animation: none; }\n\n/* 25-caption.css */\n.poster__caption {\n  position: absolute;\n  inset: auto 16px 14px;\n  z-index: 1;\n  display: none;\n  color: var(--wall-text, currentColor);\n  pointer-events: none;\n}\n\nbody[data-show-titles=\"true\"] .poster:not([data-expanded=\"true\"]) > .poster__caption:not([hidden]) {\n  display: block;\n}\n\n.poster__caption-title {\n  display: -webkit-box;\n  overflow: hidden;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: var(--caption-lines, 3);\n  overflow-wrap: anywhere;\n  font-size: 32px;\n  font-weight: 700;\n  line-height: 1.1;\n  letter-spacing: -.025em;\n}\n\n.poster__caption-artist {\n  margin-top: 4px;\n  overflow: hidden;\n  color: var(--wall-muted, currentColor);\n  font-size: 14px;\n  font-weight: 500;\n  line-height: 1.3;\n  white-space: nowrap;\n  text-overflow: ellipsis;\n}\n\n.poster__caption-artist:empty { display: none; }\n\n/* 30-controls.css */\n/* Playback controls: the cluster inside the expanded card, plus the corner locate button. */\n\n.controls {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  min-width: 0;\n  transition: opacity .25s ease;\n}\n\n.controls[data-hidden=\"true\"] {\n  opacity: 0;\n  pointer-events: none;\n}\n\n.controls__row {\n  display: flex;\n  align-items: center;\n  justify-content: flex-start;\n  gap: 0;\n}\n\n.controls__button--skip,\n.controls__button--shuffle,\n.controls__button--repeat,\n.controls__button--lyrics,\n.controls__button--album {\n  overflow: hidden;\n  transition: width .32s cubic-bezier(.2, .8, .2, 1), opacity .28s ease;\n}\n\n.controls[data-mode=\"other\"] .controls__button--skip,\n.controls[data-mode=\"other\"] .controls__button--shuffle,\n.controls[data-mode=\"other\"] .controls__button--repeat,\n.controls[data-mode=\"other\"] .controls__button--lyrics {\n  width: 0;\n  min-width: 0;\n  margin-left: 0;\n  opacity: 0;\n  pointer-events: none;\n}\n\n.controls__button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex: none;\n  width: 52px;\n  height: 52px;\n  padding: 0;\n  border: 0;\n  border-radius: 0;\n  /* theme-color-allow: icons sit on the dark cover shade in both host themes. */\n  background: transparent;\n  color: #fff;\n  cursor: pointer;\n  -webkit-tap-highlight-color: transparent;\n  transition: opacity .15s ease, transform .15s ease;\n}\n\n.controls__button svg {\n  width: 26px;\n  height: 26px;\n}\n\n.controls__button:hover {\n  opacity: .72;\n}\n\n.controls__button:active {\n  transform: scale(.94);\n}\n\n.controls__button:focus-visible {\n  outline: 2px solid #fff;\n  outline-offset: 2px;\n}\n\n.controls__button--primary {\n  width: 64px;\n  height: 64px;\n  background: transparent;\n  color: #fff;\n}\n\n.controls__button--primary svg {\n  width: 30px;\n  height: 30px;\n}\n\n.controls__button--primary:hover {\n  background: transparent;\n}\n\n.controls__button--lyrics[data-on=\"false\"],\n.controls__button--shuffle[data-on=\"false\"],\n.controls__button--repeat[data-on=\"false\"] {\n  opacity: .4;\n}\n\n.controls__glyph {\n  display: inline-flex;\n  line-height: 0;\n}\n\n/* Play / pause glyph swap, driven by data-state on .controls. */\n.controls[data-state=\"playing\"] [data-glyph=\"play\"],\n.controls[data-state=\"paused\"] [data-glyph=\"pause\"] {\n  display: none;\n}\n\n.controls[data-mode=\"other\"] .controls__button--primary [data-glyph=\"play\"] {\n  display: inline-flex;\n}\n\n.controls[data-mode=\"other\"] .controls__button--primary [data-glyph=\"pause\"] {\n  display: none;\n}\n\n/* Seek ---------------------------------------------------------------------------------------- */\n\n.controls__seek {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  width: 50%;\n  min-width: 0;\n}\n\n/* The clock belongs to the playing track; a card for another track has nothing to seek. */\n.controls[data-mode=\"other\"] .controls__seek {\n  display: none;\n}\n\n.controls__slider {\n  -webkit-appearance: none;\n  appearance: none;\n  flex: 1;\n  min-width: 0;\n  height: 16px;\n  margin: 0;\n  padding: 0;\n  border: 0;\n  border-radius: 0;\n  /* theme-color-allow: a thin white fill on the dark cover shade; the thumb is invisible. */\n  background: linear-gradient(90deg, #fff calc(var(--progress, 0) * 100%), rgb(255 255 255 / 28%) 0);\n  background-repeat: no-repeat;\n  background-size: 100% 2px;\n  background-position: 0 50%;\n  outline: none;\n  cursor: pointer;\n}\n\n.controls__slider:focus-visible {\n  box-shadow: 0 0 0 2px rgb(255 255 255 / 35%);\n}\n\n.controls__slider::-webkit-slider-runnable-track {\n  height: 16px;\n  background: transparent;\n}\n\n.controls__slider::-webkit-slider-thumb {\n  -webkit-appearance: none;\n  width: 12px;\n  height: 16px;\n  margin-top: 0;\n  border: 0;\n  border-radius: 0;\n  background: transparent;\n  box-shadow: none;\n}\n\n.controls__time {\n  flex: none;\n  font-size: 13px;\n  font-variant-numeric: tabular-nums;\n  color: rgb(255 255 255 / 85%);\n  white-space: nowrap;\n}\n\n/* Locate button (SPEC §2.5) ------------------------------------------------------------------- */\n\n/* Bottom-right corner; shown only while the playing track's expanded card is off screen. */\n.locate {\n  position: absolute;\n  right: 18px;\n  bottom: 18px;\n  z-index: 5;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 44px;\n  height: 44px;\n  padding: 0;\n  border: 1px solid color-mix(in srgb, var(--host-border) 60%, transparent);\n  border-radius: 50%;\n  background: color-mix(in srgb, var(--host-panel) 80%, transparent);\n  color: var(--host-text);\n  cursor: pointer;\n  backdrop-filter: blur(14px);\n  -webkit-tap-highlight-color: transparent;\n  transition: opacity .25s ease, transform .25s ease, background .15s ease, color .15s ease, visibility 0s linear 0s;\n}\n\n.locate svg {\n  width: 20px;\n  height: 20px;\n}\n\n.locate:hover {\n  background: color-mix(in srgb, var(--host-panel) 92%, var(--host-text));\n  color: var(--host-accent);\n}\n\n.locate:active {\n  transform: scale(.94);\n}\n\n.locate:focus-visible {\n  outline: 2px solid var(--host-accent);\n  outline-offset: 2px;\n}\n\n.locate[data-visible=\"false\"] {\n  opacity: 0;\n  visibility: hidden;\n  transform: translateY(6px);\n  pointer-events: none;\n  transition: opacity .25s ease, transform .25s ease, visibility 0s linear .25s;\n}\n\nbody[data-reduced-motion=\"true\"] .controls,\nbody[data-reduced-motion=\"true\"] .controls__button,\nbody[data-reduced-motion=\"true\"] .controls__button--skip,\nbody[data-reduced-motion=\"true\"] .controls__button--shuffle,\nbody[data-reduced-motion=\"true\"] .controls__button--repeat,\nbody[data-reduced-motion=\"true\"] .controls__button--lyrics,\nbody[data-reduced-motion=\"true\"] .controls__button--album,\nbody[data-reduced-motion=\"true\"] .controls__slider,\nbody[data-reduced-motion=\"true\"] .controls__slider::-webkit-slider-thumb,\nbody[data-reduced-motion=\"true\"] .locate {\n  transition: none;\n}\n\n/* 40-lyrics.css */\n/* Lyrics layer inside the expanded current-track card (SPEC §9). Mounted in `.poster__lyrics`\n   (`container-type: inline-size`), so cqw scales with the card width. Light text on the dark shade. */\n\n.lyrics {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  justify-content: flex-end;\n  gap: clamp(10px, 1.8cqw, 20px);\n  width: 100%;\n  height: 100%;\n  padding: 0;\n  box-sizing: border-box;\n  overflow: hidden;\n  color: var(--host-text, #fff);\n  font-family: system-ui, -apple-system, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n  text-align: left;\n  text-shadow: 0 2px 18px rgb(0 0 0 / 55%);\n  pointer-events: none;\n}\n\n/* Author `display: flex` would otherwise win over the UA `[hidden]` rule. */\n.lyrics[hidden] {\n  display: none;\n}\n\n.lyrics .sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n  border: 0;\n}\n\n.lyrics__line {\n  flex: 0 0 auto;\n  min-width: 0;\n  transform-origin: left center;\n  transition: transform .32s ease, opacity .32s ease, filter .32s ease;\n}\n\n.lyrics__line--current {\n  font-size: clamp(32px, 6.4cqw, 58px);\n  font-weight: 700;\n  opacity: 1;\n  transform: scale(1);\n}\n\n.lyrics__line--next {\n  font-size: clamp(22px, 4.4cqw, 40px);\n  font-weight: 600;\n  opacity: .5;\n  transform: scale(.8);\n  filter: blur(.6px);\n}\n\n.lyrics__text {\n  display: -webkit-box;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 3;\n  overflow: hidden;\n  line-height: 1.25;\n  overflow-wrap: anywhere;\n}\n\n.lyrics__line--next[hidden] {\n  display: none;\n}\n\n.lyrics__line--current .lyrics__text {\n  display: block;\n  overflow: visible;\n  -webkit-line-clamp: unset;\n  text-shadow: none;\n}\n\n.lyrics__translation {\n  display: none;\n  margin-top: .25em;\n  font-size: .62em;\n  font-weight: 500;\n  line-height: 1.3;\n  opacity: .68;\n}\n\n.lyrics[data-translation=\"true\"] .lyrics__translation:not(:empty) {\n  display: -webkit-box;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 2;\n  overflow: hidden;\n}\n\n/* Glow follows glyphs only: no filter / overflow clip, or the bloom becomes a rectangle. */\n.lyrics__word {\n  display: inline;\n  color: rgb(255 255 255 / 38%);\n  text-shadow: none;\n}\n\n.lyrics__word--sung {\n  color: rgb(255 255 255 / 94%);\n}\n\n.lyrics__word--active {\n  color: #fff;\n  text-shadow:\n    0 0 .04em rgb(255 255 255 / 70%),\n    0 0 .14em rgb(255 255 255 / 36%);\n}\n\n.lyrics__plain {\n  flex: 0 1 auto;\n  min-height: 0;\n  max-height: 100%;\n  overflow: auto;\n  overscroll-behavior: contain;\n  pointer-events: auto;\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n  font-size: clamp(22px, 3.6cqw, 32px);\n  line-height: 1.6;\n}\n\n.lyrics__plain::-webkit-scrollbar {\n  width: 6px;\n}\n\n.lyrics__plain::-webkit-scrollbar-thumb {\n  background: rgb(255 255 255 / 30%);\n  border-radius: 3px;\n}\n\n.lyrics__instrumental {\n  text-align: center;\n  font-size: clamp(28px, 5cqw, 46px);\n  font-weight: 600;\n  letter-spacing: .08em;\n  opacity: .85;\n}\n\n/* Light scheme: the layer still sits on the dark shade, so text stays light with a softer shadow. */\nhtml[data-color-scheme=\"light\"] .lyrics,\nbody[data-color-scheme=\"light\"] .lyrics {\n  color: rgb(255 255 255 / 96%);\n  text-shadow: 0 1px 10px rgb(0 0 0 / 40%);\n}\n\nhtml[data-color-scheme=\"light\"] .lyrics__line--current .lyrics__text,\nbody[data-color-scheme=\"light\"] .lyrics__line--current .lyrics__text {\n  text-shadow: none;\n}\n\n/* Reduced motion: no scale, blur or transitions; the whole current line stays highlighted. */\n.lyrics[data-reduced-motion=\"true\"] .lyrics__line,\nbody[data-reduced-motion=\"true\"] .lyrics .lyrics__line {\n  transform: none;\n  filter: none;\n  transition: none;\n}\n\n.lyrics[data-reduced-motion=\"true\"] .lyrics__line--next,\nbody[data-reduced-motion=\"true\"] .lyrics .lyrics__line--next {\n  opacity: .55;\n}\n\n.lyrics[data-reduced-motion=\"true\"] .lyrics__line--current .lyrics__text,\nbody[data-reduced-motion=\"true\"] .lyrics .lyrics__line--current .lyrics__text {\n  filter: none;\n}\n\n.lyrics[data-reduced-motion=\"true\"] .lyrics__word,\nbody[data-reduced-motion=\"true\"] .lyrics .lyrics__word {\n  color: rgb(255 255 255 / 88%);\n  text-shadow: none;\n}\n\n.lyrics[data-reduced-motion=\"true\"] .lyrics__word--active,\n.lyrics[data-reduced-motion=\"true\"] .lyrics__word--sung,\nbody[data-reduced-motion=\"true\"] .lyrics .lyrics__word--active,\nbody[data-reduced-motion=\"true\"] .lyrics .lyrics__word--sung {\n  color: #fff;\n}\n\n/* 50-states.css */\nbody[data-state='booting'] .field,\nbody[data-state='empty'] .field,\nbody[data-state='denied'] .field{\n  opacity: 0;\n  pointer-events: none;\n}\n\nbody[data-state='error'] .field{\n  opacity: 0;\n  pointer-events: none;\n}\n\nbody[data-state='ready'] .field{\n  opacity: 1;\n}\n\n.state{\n  position: absolute;\n  inset: 0;\n  z-index: 6;\n  display: grid;\n  place-content: center;\n  justify-items: center;\n  gap: 10px;\n  padding: 32px;\n  text-align: center;\n  color: var(--wall-text);\n  background: var(--wall-background);\n}\n\n.state[hidden] {\n  display: none;\n}\n\nbody[data-opening=\"true\"] .state,\nbody[data-opening=\"true\"] .locate,\nbody[data-opening=\"true\"] .notice {\n  visibility: hidden;\n}\n\n.state__title{\n  margin: 0;\n  font-size: clamp(20px, 2.4vw, 28px);\n  font-weight: 700;\n  letter-spacing: -0.01em;\n}\n\n.state__body{\n  max-width: 460px;\n  margin: 0;\n  color: var(--wall-muted);\n  font-size: 14px;\n  line-height: 1.6;\n}\n\n.state[data-state='denied'] .state__title::before{\n  content: '';\n  display: block;\n  width: 10px;\n  height: 10px;\n  margin: 0 auto 14px;\n  border-radius: 50%;\n  background: var(--host-accent);\n  box-shadow: 0 0 0 6px color-mix(in srgb, var(--host-accent) 22%, transparent);\n}\n\n.state[data-state='booting'] .state__title::before{\n  content: '';\n  display: block;\n  width: 18px;\n  height: 18px;\n  margin: 0 auto 14px;\n  border: 2px solid color-mix(in srgb, var(--host-accent) 30%, transparent);\n  border-top-color: var(--host-accent);\n  border-radius: 50%;\n  animation: state-spin 0.9s linear infinite;\n}\n\nbody[data-reduced-motion='true'] .state[data-state='booting'] .state__title::before{\n  animation: none;\n}\n\n@keyframes state-spin {\n  to { transform: rotate(360deg); }\n}\n\n.notice{\n  position: absolute;\n  left: 14px;\n  bottom: 14px;\n  z-index: 5;\n  padding: 5px 10px;\n  border: 1px solid color-mix(in srgb, var(--host-border) 60%, transparent);\n  border-radius: 999px;\n  color: var(--host-muted);\n  background: color-mix(in srgb, var(--host-panel) 82%, transparent);\n  font-size: 11px;\n  letter-spacing: 0.02em;\n  backdrop-filter: blur(12px);\n  pointer-events: none;\n}\n\n/* 60-albums.css */\n@property --album-slot-height{\n  syntax: '<length>';\n  inherits: true;\n  initial-value: 0px;\n}\n.album-tracks :focus-visible{\n  outline: 2px solid var(--wall-text);\n  outline-offset: -2px;\n}\n.poster__expanded.poster__expanded--album{\n  --album-scale: 1;\n  display: flex;\n  flex-direction: column-reverse;\n}\n.poster__expanded--album::before{\n  content: '';\n  position: absolute;\n  inset: 0;\n  z-index: -1;\n  pointer-events: none;\n  /* Blend into the cover instead of outlining the list as a separate card. */\n  background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--wall-background) 72%, transparent) 20%, color-mix(in srgb, var(--wall-background) 82%, transparent));\n  opacity: 0;\n  transition: opacity .22s ease;\n}\n.poster__expanded--album:has(.album-details[data-open=\"true\"])::before{\n  opacity: 1;\n}\n.world[data-fisheye-surface=\"true\"] .poster__expanded--album::before{\n  /* The GPU paints this backdrop through the same continuous lens as the cover. Keep the\n     pseudo-element's opacity timeline available to the renderer, including its closing fade. */\n  visibility: hidden;\n}\n.poster__expanded.poster__expanded--album .poster__meta{\n  order: 3;\n  margin-top: 0;\n  pointer-events: auto;\n}\n.poster__expanded.poster__expanded--album .poster__lyrics{\n  display: grid;\n  order: 2;\n  height: calc(var(--album-slot-height) * var(--lyrics-open));\n  max-height: none;\n  min-height: 0;\n  overflow: hidden;\n}\n.poster__expanded.poster__expanded--album .poster__controls{\n  order: 1;\n}\n.poster__expanded.poster__expanded--album .poster__title{\n  --title-scale: calc(1 - var(--lyrics-open) * (1 - var(--title-open-scale, 1)));\n  height: calc(var(--title-natural-height) * var(--title-scale));\n}\n.poster__expanded.poster__expanded--album .poster__artist{\n  transform: translateZ(0);\n}\n.album-details,\n.album-lyrics{\n  grid-area: 1 / 1;\n  display: flex;\n  flex-direction: column;\n  /* Retain a stable list viewport; the outer slot owns the expansion and clipping. */\n  height: var(--lyrics-open-height, 0px);\n  min-height: 0;\n  min-width: 0;\n  opacity: 1;\n  visibility: visible;\n  transform: translateY(0);\n  transition: opacity .22s ease, transform .22s ease, visibility 0s;\n}\n.album-details[data-open=\"false\"],\n.album-lyrics[data-open=\"false\"] {\n  opacity: 0;\n  visibility: hidden;\n  transform: translateY(calc(10px / var(--album-scale)));\n  pointer-events: none;\n  transition: opacity .22s ease, transform .22s ease, visibility 0s .22s;\n}\n/* Switching content hides the outgoing panel immediately; only the incoming panel fades in.\n   A direct close still fades out, and no intermediate frame paints lyrics over track rows. */\n[data-album-view=\"lyrics\"] .album-details,\n[data-album-view=\"tracks\"] .album-lyrics{\n  visibility: hidden;\n  transition: none;\n}\n.album-lyrics{\n  /* During intrinsic measurement, auto height must not stretch to the hidden track list's\n     grid row. Otherwise the previous list / long lyric height keeps pushing the title up. */\n  align-self: start;\n  justify-content: flex-end;\n  overflow: hidden;\n}\n.poster__expanded--album .album-lyrics .lyrics{\n  max-height: 100%;\n  min-height: 0;\n  overflow: auto;\n  scrollbar-width: none;\n}\n.album-lyrics .lyrics::-webkit-scrollbar{ display: none; }\n.album-details__message{\n  flex-shrink: 0;\n  margin: 0 0 calc(8px / var(--album-scale));\n  padding-inline: calc(12px / var(--album-scale));\n  font-size: calc(13px / var(--album-scale));\n  font-weight: 500;\n  color: var(--wall-muted);\n}\n.album-tracks{\n  flex: 1;\n  min-height: 0;\n  min-width: 0;\n  overflow-x: hidden;\n  overflow-y: auto;\n  overflow-anchor: none;\n  overscroll-behavior: contain;\n  touch-action: pan-y;\n  scrollbar-gutter: stable;\n}\n/* Keep the gutter stable while the thumb is hidden, so row widths never jump. */\n.album-tracks::-webkit-scrollbar{ width: calc(8px / var(--album-scale)); height: calc(8px / var(--album-scale)); background: transparent; }\n.album-tracks::-webkit-scrollbar-track,\n.album-tracks::-webkit-scrollbar-corner{ background: transparent; }\n.album-tracks::-webkit-scrollbar-track{ margin-block: calc(48px / var(--album-scale)); }\n.album-tracks::-webkit-scrollbar-thumb{\n  /* A 4px visible stroke retains an 8px drag target. Insets also shorten its travel. */\n  border: calc(2px / var(--album-scale)) solid transparent;\n  background: transparent;\n  background-clip: padding-box;\n  border-radius: 999px;\n}\n.album-tracks[data-scrolling=\"true\"]::-webkit-scrollbar-thumb{\n  background-color: color-mix(in srgb, var(--wall-text) 45%, transparent);\n}\n.album-tracks[data-scrolling=\"true\"]::-webkit-scrollbar-thumb:hover{\n  background-color: color-mix(in srgb, var(--wall-text) 65%, transparent);\n}\n.album-tracks::-webkit-scrollbar-button{ display: none; width: 0; height: 0; }\n/* Cover text keeps its overlay contrast in both host themes. */\n.album-track-row{\n  display: grid;\n  grid-template-columns: 2.25em minmax(0, 1fr) 4.5em;\n  align-items: center;\n  gap: calc(12px / var(--album-scale));\n  width: 100%;\n  height: var(--album-track-height, calc(48px / var(--album-scale)));\n  padding: calc(8px / var(--album-scale)) calc(12px / var(--album-scale));\n  border: 0;\n  border-bottom: 1px solid color-mix(in srgb, var(--wall-text) 10%, transparent);\n  text-align: left;\n  background: transparent;\n  color: var(--wall-text);\n  font: inherit;\n  font-size: calc(16px / var(--album-scale));\n  font-weight: 500;\n  line-height: 1.4;\n  cursor: pointer;\n  transition: background-color .16s ease;\n}\n.album-tracks__placeholder{ display: flex; color: var(--wall-muted); font-size: calc(13px / var(--album-scale)); }\n.album-tracks__placeholder:not(button) { cursor: default; }\n.album-tracks button:not(:disabled):hover,\n.album-tracks button[aria-current=\"true\"] { background: color-mix(in srgb, var(--wall-text) 6%, transparent); }\n.album-tracks button[aria-current=\"true\"] .album-track__title{ font-weight: 600; }\n.album-tracks button[aria-current=\"true\"] .album-track__number{ color: var(--wall-text); }\n.album-tracks button:disabled{ color: var(--wall-muted); cursor: default; }\n.album-track__title{ overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.album-track__number,\n.album-track__time{ color: color-mix(in srgb, var(--wall-text) 82%, transparent); font-variant-numeric: tabular-nums; font-size: .875em; white-space: nowrap; }\n.album-track__time{ text-align: right; }\n\n.album-content-toggles{\n  display: flex;\n  align-items: center;\n  margin-left: auto;\n  gap: 8px;\n}\n.album-actions .controls__button--album,\n.album-actions .album-content-toggle{\n  width: 64px;\n  height: 64px;\n}\n.album-actions .album-content-toggle{\n  color: var(--wall-text);\n  transition: color .22s ease, opacity .15s ease, transform .15s ease;\n}\n.album-actions .controls__button--album > svg,\n.album-actions .album-content-toggle > svg{ width: 30px; height: 30px; }\n.album-actions .album-content-toggle[hidden] { display: none; }\n.album-content-toggle[aria-expanded=\"false\"] { color: var(--wall-muted); }\n.album-content-toggle:disabled{ opacity: .35; cursor: default; }\n\nbody[data-reduced-motion=\"true\"] .album-details,\nbody[data-reduced-motion=\"true\"] .poster__expanded--album::before,\nbody[data-reduced-motion=\"true\"] .album-lyrics,\nbody[data-reduced-motion=\"true\"] .album-track-row,\nbody[data-reduced-motion=\"true\"] .album-actions .album-content-toggle{\n  transition: none;\n}\n\n.controls.album-actions[data-mode=\"other\"] .controls__button--primary{\n  overflow: hidden;\n  width: 0;\n  min-width: 0;\n  margin-left: 0;\n  opacity: 0;\n  pointer-events: none;\n}\n\n/* 65-control-panel.css */\n/* Function panel: monochrome editorial sheet. Opaque near-black surface, hairline rules instead of\n   boxes, light display type, and inverted (ink-on-paper) selection. The host accent is reserved for\n   keyboard focus. Light hosts get the same sheet in reverse. */\n\n.control-panel {\n  --cp-surface: color-mix(in srgb, var(--host-panel) 22%, var(--wall-background));\n  --cp-raised: color-mix(in srgb, var(--host-text) 4%, var(--cp-surface));\n  --cp-ink: var(--host-text);\n  --cp-paper: var(--cp-surface);\n  --cp-soft: color-mix(in srgb, var(--host-text) 62%, transparent);\n  --cp-faint: color-mix(in srgb, var(--host-text) 40%, transparent);\n  --cp-rule: color-mix(in srgb, var(--host-text) 9%, transparent);\n  --cp-edge: color-mix(in srgb, var(--host-text) 14%, transparent);\n  --cp-hover: color-mix(in srgb, var(--host-text) 5%, transparent);\n  --cp-mono: ui-monospace, \"SF Mono\", \"Cascadia Mono\", \"JetBrains Mono\", Consolas, monospace;\n  --cp-ease: cubic-bezier(.16, 1, .3, 1);\n  position: fixed;\n  inset: 0;\n  width: min(860px, calc(100% - 40px));\n  max-width: none;\n  height: min(640px, calc(100dvh - 56px));\n  max-height: calc(100dvh - 56px);\n  margin: auto;\n  padding: 0;\n  overflow: hidden;\n  border: 1px solid var(--cp-edge);\n  border-radius: 14px;\n  background:\n    linear-gradient(180deg, color-mix(in srgb, var(--host-text) 3%, transparent), transparent 140px),\n    var(--cp-surface);\n  color: var(--cp-ink);\n  font-size: 13px;\n  line-height: 1.55;\n  letter-spacing: .01em;\n  box-shadow:\n    0 1px 0 color-mix(in srgb, var(--host-text) 6%, transparent) inset,\n    0 50px 140px color-mix(in srgb, var(--wall-background) 70%, transparent),\n    0 12px 32px color-mix(in srgb, var(--wall-background) 40%, transparent);\n}\nhtml[data-color-scheme=\"light\"] .control-panel {\n  --cp-surface: color-mix(in srgb, var(--host-panel) 94%, var(--host-app-bg));\n}\n\n.control-panel:not([open]),\n.control-panel [hidden] { display: none; }\n/* A light dim keeps the wall readable around the sheet, so lighting changes can be judged live. */\n.control-panel::backdrop {\n  background: color-mix(in srgb, var(--wall-background) 48%, transparent);\n}\n.control-panel[open] { animation: control-panel-in .32s var(--cp-ease); }\n@keyframes control-panel-in {\n  from { opacity: 0; transform: translateY(10px) scale(.985); }\n  to { opacity: 1; transform: none; }\n}\n.control-panel__form {\n  display: grid;\n  grid-template-columns: 200px minmax(0, 1fr);\n  height: 100%;\n  max-height: inherit;\n  margin: 0;\n}\n\n/* ---- sidebar ---------------------------------------------------------------------------------- */\n.control-panel__sidebar {\n  display: flex;\n  flex-direction: column;\n  gap: 28px;\n  min-height: 0;\n  padding: 28px 0 22px;\n  border-right: 1px solid var(--cp-rule);\n}\n.control-panel__brand { padding: 0 26px; }\n.control-panel__wordmark {\n  margin: 0 0 10px;\n  color: var(--cp-faint);\n  font: 600 10px/1 var(--cp-mono);\n  letter-spacing: .32em;\n  text-transform: uppercase;\n}\n.control-panel__brand h2 {\n  margin: 0;\n  font-size: 17px;\n  font-weight: 500;\n  letter-spacing: .04em;\n}\n.control-panel__brand-wall {\n  margin: 4px 0 0;\n  color: var(--cp-soft);\n  font-size: 12px;\n}\n.control-panel__tabs {\n  display: flex;\n  flex-direction: column;\n  min-height: 0;\n  overflow-y: auto;\n  scrollbar-width: none;\n}\n.control-panel .control-panel__tab {\n  position: relative;\n  display: flex;\n  align-items: baseline;\n  gap: 14px;\n  width: 100%;\n  min-height: 44px;\n  padding: 11px 26px;\n  border: 0;\n  border-radius: 0;\n  color: var(--cp-soft);\n  font-size: 14px;\n  letter-spacing: .06em;\n  text-align: start;\n}\n.control-panel .control-panel__tab:hover:not(:disabled) { background-color: transparent; color: var(--cp-ink); }\n.control-panel .control-panel__tab[aria-selected=\"true\"] { color: var(--cp-ink); font-weight: 500; }\n.control-panel .control-panel__tab:focus-visible { border-radius: 6px; outline-offset: -4px; }\n/* Selected mark: a short rule on the sidebar edge. */\n.control-panel__tab::before {\n  content: \"\";\n  position: absolute;\n  top: 50%;\n  left: 0;\n  width: 2px;\n  height: 0;\n  background: var(--cp-ink);\n  transform: translateY(-50%);\n  transition: height .28s var(--cp-ease);\n}\n.control-panel__tab[aria-selected=\"true\"]::before { height: 18px; }\n.control-panel__tab-index {\n  flex: none;\n  color: var(--cp-faint);\n  font: 500 10.5px/1 var(--cp-mono);\n  letter-spacing: .08em;\n  font-variant-numeric: tabular-nums;\n}\n.control-panel__tab[aria-selected=\"true\"] .control-panel__tab-index { color: var(--cp-ink); }\n.control-panel__footer {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  margin-top: auto;\n  padding: 0 26px;\n  color: var(--cp-faint);\n  font-size: 11.5px;\n  letter-spacing: .04em;\n}\n.control-panel__shortcut { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px; }\n.control-panel__icon { display: inline-flex; flex: none; width: 16px; height: 16px; }\n.control-panel__icon svg { width: 100%; height: 100%; stroke-width: 1.5; }\n\n/* ---- main column ------------------------------------------------------------------------------ */\n.control-panel__main {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  min-height: 0;\n}\n.control-panel__header {\n  display: flex;\n  flex-shrink: 0;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 30px 22px 22px 40px;\n}\n.control-panel__page-heading { min-width: 0; }\n.control-panel__page-title {\n  margin: 0;\n  font-size: 28px;\n  font-weight: 300;\n  letter-spacing: .06em;\n  line-height: 1.15;\n}\n.control-panel__page-description {\n  margin: 8px 0 0;\n  color: var(--cp-soft);\n  font-size: 12.5px;\n  letter-spacing: .04em;\n}\n.control-panel .control-panel__dismiss {\n  flex: none;\n  width: 34px;\n  min-height: 34px;\n  padding: 0;\n  border: 1px solid var(--cp-rule);\n  border-radius: 50%;\n  color: var(--cp-soft);\n}\n.control-panel .control-panel__dismiss:hover:not(:disabled) { border-color: var(--cp-edge); background-color: var(--cp-hover); color: var(--cp-ink); }\n.control-panel__dismiss .control-panel__icon { width: 15px; height: 15px; margin: auto; }\n.control-panel__pages {\n  flex: 1;\n  min-height: 0;\n  padding: 0 40px 36px;\n  overflow-y: auto;\n  overscroll-behavior: contain;\n  scrollbar-width: thin;\n  scrollbar-color: var(--cp-edge) transparent;\n}\n.control-panel__page {\n  display: flex;\n  flex-direction: column;\n  gap: 34px;\n  animation: control-panel-page-in .26s var(--cp-ease);\n}\n@keyframes control-panel-page-in {\n  from { opacity: 0; transform: translateY(6px); }\n  to { opacity: 1; transform: none; }\n}\n\n/* ---- sections and rows: hairline rules, no boxes ---------------------------------------------- */\n.control-panel__group { display: flex; flex-direction: column; min-width: 0; }\n/* Small spaced label followed by a rule that runs to the edge. */\n.control-panel__group-title {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  margin: 0 0 4px;\n  color: var(--cp-faint);\n  font-size: 11px;\n  font-weight: 500;\n  letter-spacing: .24em;\n}\n.control-panel__group-title::after {\n  content: \"\";\n  flex: 1;\n  height: 1px;\n  background: var(--cp-rule);\n}\n.control-panel__card { display: flex; flex-direction: column; }\n/* Raised above `.control-panel button` so switch rows keep their rule. */\n.control-panel .control-panel__card > * + * { border-top: 1px solid var(--cp-rule); }\n.control-panel__note {\n  margin: 10px 0 0;\n  color: var(--cp-faint);\n  font-size: 11.5px;\n  line-height: 1.7;\n  letter-spacing: .03em;\n}\n.control-panel__note:empty { display: none; }\n.control-panel__item {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 24px;\n  min-width: 0;\n  min-height: 60px;\n  padding: 12px 0;\n}\n.control-panel__item--sub { position: relative; padding-left: 26px; }\n/* Dependency guide: a hairline elbow from the parent setting. */\n.control-panel__item--sub::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 6px;\n  width: 9px;\n  height: 50%;\n  border-bottom: 1px solid var(--cp-edge);\n  border-left: 1px solid var(--cp-edge);\n}\n.control-panel .control-panel__card > .control-panel__item--sub { border-top-color: transparent; }\n.control-panel__item-text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }\n.control-panel__item-label {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  color: var(--cp-ink);\n  font-size: 14px;\n  letter-spacing: .03em;\n}\n.control-panel__item-hint { color: var(--cp-soft); font-size: 12px; line-height: 1.5; letter-spacing: .02em; }\n.control-panel__item-hint:empty { display: none; }\n.control-panel__item-control {\n  display: flex;\n  flex: none;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 14px;\n  min-width: 0;\n}\n.control-panel__item--wide .control-panel__item-text { flex: 0 1 auto; }\n.control-panel__item--wide .control-panel__item-control { flex: 1 1 220px; max-width: 320px; }\n.control-panel__item.is-disabled .control-panel__item-text { opacity: .38; }\n\n/* ---- buttons, switches, key caps, segments ---------------------------------------------------- */\n.control-panel button {\n  min-height: 32px;\n  padding: 6px 12px;\n  border: 1px solid transparent;\n  border-radius: 999px;\n  background-color: transparent;\n  color: var(--cp-ink);\n  font: inherit;\n  letter-spacing: .04em;\n  white-space: nowrap;\n  cursor: pointer;\n  transition: background-color .2s ease, color .2s ease, border-color .2s ease;\n}\n.control-panel button:hover:not(:disabled) { background-color: var(--cp-hover); }\n.control-panel button:disabled,\n.control-panel input:disabled,\n.control-panel select:disabled { opacity: .32; cursor: default; }\n.control-panel :focus-visible { outline: 1.5px solid var(--host-accent); outline-offset: 3px; }\n/* Hairline pills: pager, 1×, restore default, shortcut recorder. */\n.control-panel .control-panel__chip,\n.control-panel__pager-buttons button,\n.control-panel .control-panel__shortcut-record {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  min-height: 30px;\n  padding: 4px 14px;\n  border-color: var(--cp-edge);\n  font-size: 12px;\n}\n.control-panel .control-panel__chip:hover:not(:disabled),\n.control-panel__pager-buttons button:hover:not(:disabled),\n.control-panel .control-panel__shortcut-record:hover:not(:disabled) { border-color: var(--cp-ink); background-color: transparent; }\n.control-panel .control-panel__chip .control-panel__icon,\n.control-panel__pager-buttons .control-panel__icon { width: 13px; height: 13px; }\n\n/* Whole-row switch. Disabled rows dim text and track instead of the whole button. */\n.control-panel .control-panel__toggle {\n  width: 100%;\n  min-height: 60px;\n  padding: 12px 0;\n  border-width: 1px 0 0;\n  border-radius: 0;\n  font-size: inherit;\n  letter-spacing: inherit;\n  text-align: start;\n  white-space: normal;\n}\n.control-panel__card > .control-panel__toggle:first-child { border-top-width: 0; }\n.control-panel .control-panel__toggle:hover:not(:disabled) { background-color: transparent; }\n.control-panel .control-panel__toggle.control-panel__item--sub { padding-left: 26px; }\n.control-panel .control-panel__toggle:disabled { opacity: 1; }\n.control-panel .control-panel__toggle:focus-visible { outline-offset: -1px; }\n.control-panel__switch {\n  position: relative;\n  flex: 0 0 34px;\n  height: 18px;\n  border: 1px solid var(--cp-faint);\n  border-radius: 9px;\n  transition: background-color .25s ease, border-color .25s ease;\n}\n.control-panel__switch::after {\n  content: \"\";\n  position: absolute;\n  top: 3px;\n  left: 3px;\n  width: 10px;\n  height: 10px;\n  border-radius: 50%;\n  background: var(--cp-soft);\n  transition: transform .3s var(--cp-ease), background-color .25s ease;\n}\n.control-panel__toggle:hover:not(:disabled) .control-panel__switch { border-color: var(--cp-ink); }\n.control-panel__toggle[aria-checked=\"true\"] .control-panel__switch { border-color: var(--cp-ink); background-color: var(--cp-ink); }\n.control-panel__toggle[aria-checked=\"true\"] .control-panel__switch::after { transform: translateX(16px); background: var(--cp-paper); }\n.control-panel__toggle:disabled .control-panel__switch { opacity: .32; }\n.control-panel__key,\n.control-panel kbd {\n  display: inline-block;\n  min-width: 18px;\n  padding: 1px 5px;\n  border: 1px solid var(--cp-edge);\n  border-radius: 4px;\n  color: var(--cp-soft);\n  font: 500 10.5px/1.5 var(--cp-mono);\n  letter-spacing: .04em;\n  text-align: center;\n}\n/* One-of-n: hairline capsule, the chosen option printed in reverse. */\n.control-panel__segments {\n  display: inline-flex;\n  flex-shrink: 0;\n  align-items: center;\n  gap: 0;\n  padding: 2px;\n  border: 1px solid var(--cp-edge);\n  border-radius: 999px;\n}\n.control-panel .control-panel__segments button {\n  flex: 1;\n  min-width: 44px;\n  min-height: 26px;\n  padding: 3px 13px;\n  color: var(--cp-soft);\n  font-size: 12px;\n}\n.control-panel .control-panel__segments button:hover:not(:disabled) { background-color: transparent; color: var(--cp-ink); }\n.control-panel .control-panel__segments button[aria-pressed=\"true\"] {\n  background-color: var(--cp-ink);\n  color: var(--cp-paper);\n  font-weight: 500;\n}\n\n/* ---- fields and sliders ----------------------------------------------------------------------- */\n.control-panel input,\n.control-panel select {\n  box-sizing: border-box;\n  width: 100%;\n  min-width: 0;\n  min-height: 34px;\n  padding: 0 12px;\n  border: 1px solid var(--cp-edge);\n  border-radius: 8px;\n  background-color: transparent;\n  color: var(--cp-ink);\n  font: inherit;\n  letter-spacing: .02em;\n  transition: border-color .2s ease;\n}\n.control-panel input:hover:not(:disabled),\n.control-panel select:hover:not(:disabled),\n.control-panel input:focus,\n.control-panel select:focus { border-color: var(--cp-ink); }\n.control-panel select { width: 168px; cursor: pointer; }\n.control-panel select option { background-color: var(--host-panel); color: var(--host-text); }\n.control-panel input::placeholder { color: var(--cp-faint); }\n.control-panel input[type=\"color\"] {\n  flex: none;\n  width: 30px;\n  min-width: 30px;\n  height: 30px;\n  min-height: 30px;\n  padding: 3px;\n  border-radius: 50%;\n  cursor: pointer;\n}\n.control-panel input[type=\"color\"]::-webkit-color-swatch-wrapper { padding: 0; }\n.control-panel input[type=\"color\"]::-webkit-color-swatch { border: 0; border-radius: 50%; }\n.control-panel input[type=\"range\"] {\n  --fill: 50%;\n  flex: 1;\n  min-width: 96px;\n  height: 20px;\n  min-height: 20px;\n  margin: 0;\n  padding: 0;\n  border: 0;\n  border-radius: 0;\n  background-color: transparent;\n  cursor: pointer;\n  -webkit-appearance: none;\n  appearance: none;\n}\n.control-panel input[type=\"range\"]::-webkit-slider-runnable-track {\n  height: 2px;\n  background: linear-gradient(to right, var(--cp-ink) var(--fill), var(--cp-edge) var(--fill));\n}\n.control-panel input[type=\"range\"]::-webkit-slider-thumb {\n  width: 13px;\n  height: 13px;\n  margin-top: -5.5px;\n  border: 0;\n  border-radius: 50%;\n  background: var(--cp-ink);\n  box-shadow: 0 0 0 3px var(--cp-surface);\n  transition: transform .2s var(--cp-ease);\n  -webkit-appearance: none;\n  appearance: none;\n}\n.control-panel input[type=\"range\"]:hover:not(:disabled)::-webkit-slider-thumb,\n.control-panel input[type=\"range\"]:active:not(:disabled)::-webkit-slider-thumb { transform: scale(1.25); }\n.control-panel__value {\n  flex: none;\n  min-width: 52px;\n  color: var(--cp-ink);\n  font: 500 12px/1 var(--cp-mono);\n  font-variant-numeric: tabular-nums;\n  letter-spacing: .02em;\n  text-align: end;\n}\n.control-panel__value--code { min-width: 64px; color: var(--cp-soft); }\n\n/* ---- browse page ------------------------------------------------------------------------------ */\n.control-panel__walls {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 12px;\n  padding: 14px 0 2px;\n}\n.control-panel .control-panel__wall {\n  position: relative;\n  display: flex;\n  align-items: flex-start;\n  min-height: 78px;\n  padding: 16px 44px 16px 18px;\n  border: 1px solid var(--cp-rule);\n  border-radius: 10px;\n  text-align: start;\n  white-space: normal;\n}\n.control-panel .control-panel__wall:hover:not(:disabled) { border-color: var(--cp-edge); background-color: transparent; }\n.control-panel .control-panel__wall[aria-pressed=\"true\"] {\n  border-color: var(--cp-ink);\n  background-color: var(--cp-raised);\n  cursor: default;\n}\n.control-panel__wall-text { display: flex; flex-direction: column; gap: 4px; min-width: 0; }\n.control-panel__wall-name { font-size: 15px; letter-spacing: .06em; }\n.control-panel__wall-description { color: var(--cp-soft); font-size: 12px; letter-spacing: .03em; }\n/* Radio mark: a hairline ring, filled for the current wall. */\n.control-panel__wall-dot {\n  position: absolute;\n  top: 18px;\n  right: 18px;\n  width: 12px;\n  height: 12px;\n  border: 1px solid var(--cp-faint);\n  border-radius: 50%;\n}\n.control-panel__wall[aria-pressed=\"true\"] .control-panel__wall-dot {\n  border-color: var(--cp-ink);\n  background: var(--cp-ink);\n  box-shadow: inset 0 0 0 2.5px var(--cp-raised);\n}\n.control-panel__search-body { padding: 10px 0 4px; }\n.control-panel__search { position: relative; display: flex; align-items: center; }\n.control-panel__search .control-panel__icon {\n  position: absolute;\n  left: 0;\n  width: 17px;\n  height: 17px;\n  color: var(--cp-faint);\n  pointer-events: none;\n}\n.control-panel input[type=\"search\"] {\n  min-height: 50px;\n  padding: 0 0 0 30px;\n  border-width: 0 0 1px;\n  border-radius: 0;\n  font-size: 18px;\n  font-weight: 300;\n  letter-spacing: .04em;\n}\n.control-panel input[type=\"search\"]::-webkit-search-cancel-button { filter: grayscale(1); opacity: .5; cursor: pointer; }\n/* Focus thickens the underline instead of boxing the field. */\n.control-panel input[type=\"search\"]:focus-visible { outline: 0; box-shadow: 0 1px 0 var(--cp-ink); }\n.control-panel__search:focus-within .control-panel__icon { color: var(--cp-ink); }\n.control-panel__pager {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px 16px;\n  padding: 14px 0;\n}\n.control-panel__status {\n  color: var(--cp-soft);\n  font-size: 12px;\n  font-variant-numeric: tabular-nums;\n  letter-spacing: .04em;\n}\n.control-panel__pager-buttons { display: flex; gap: 8px; }\n\n/* ---- general page ----------------------------------------------------------------------------- */\n.control-panel .control-panel__shortcut-record { justify-content: center; min-width: 120px; gap: 4px; }\n.control-panel .control-panel__shortcut-record[aria-pressed=\"true\"] { border-color: var(--cp-ink); background-color: var(--cp-hover); }\n.control-panel__keys {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 12px 32px;\n  margin: 0;\n  padding: 18px 0 6px;\n}\n.control-panel__keys-item { display: flex; align-items: baseline; gap: 12px; min-width: 0; }\n.control-panel__keys dt { display: flex; flex: none; gap: 4px; min-width: 76px; }\n.control-panel__keys dd { margin: 0; color: var(--cp-soft); font-size: 12px; letter-spacing: .02em; }\n\n/* ---- narrow windows: the sidebar becomes a top strip (see NARROW in controlPanelTabs.ts) -------- */\n@media (max-width: 640px) {\n  .control-panel {\n    width: calc(100% - 20px);\n    height: calc(100dvh - 20px);\n    max-height: calc(100dvh - 20px);\n  }\n  .control-panel__form { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto minmax(0, 1fr); }\n  .control-panel__sidebar { padding: 0; border-right: 0; border-bottom: 1px solid var(--cp-rule); }\n  .control-panel__brand,\n  .control-panel__footer { display: none; }\n  .control-panel__tabs { flex-direction: row; overflow-x: auto; }\n  .control-panel .control-panel__tab { flex: none; width: auto; min-height: 48px; padding: 14px 16px; }\n  .control-panel__tab::before { top: auto; bottom: 0; left: 50%; width: 0; height: 2px; transform: translateX(-50%); transition-property: width; }\n  .control-panel__tab[aria-selected=\"true\"]::before { width: 18px; height: 2px; }\n  .control-panel__header { padding: 22px 14px 16px 22px; }\n  .control-panel__pages { padding: 0 22px 24px; }\n  .control-panel__item--wide { flex-wrap: wrap; }\n  .control-panel__item--wide .control-panel__item-control { flex-basis: 100%; max-width: none; }\n  .control-panel__walls,\n  .control-panel__keys { grid-template-columns: minmax(0, 1fr); }\n}\n\nbody[data-reduced-motion=\"true\"] .control-panel,\nbody[data-reduced-motion=\"true\"] .control-panel *,\nbody[data-reduced-motion=\"true\"] .control-panel *::before,\nbody[data-reduced-motion=\"true\"] .control-panel *::after { transition: none; animation: none; }\n@media (prefers-reduced-motion: reduce) {\n  .control-panel,\n  .control-panel *,\n  .control-panel *::before,\n  .control-panel *::after { transition: none; animation: none; }\n}\n\n/* 70-theme.css */\n.lattice-wall-host,\n.lattice-wall {\n  height: 100%;\n}\n\nbody[data-desktop-wall=\"true\"] .locate {\n  bottom: calc(18px + var(--desktop-wall-bottom-inset, 0px));\n}\n"
    },
    {
      "path": "panel.html",
      "content": "<!doctype html>\n<!-- Lattice Wall | Copyright (c) 2026 Lattice Wall contributors | SPDX-License-Identifier: AGPL-3.0-only -->\n<html lang=\"zh-CN\" data-color-scheme=\"dark\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Lattice · 曲库拼贴墙</title>\n  <link rel=\"stylesheet\" href=\"panel.css\">\n</head>\n<body data-state=\"booting\" data-opening=\"true\">\n  <main class=\"lattice\" id=\"lattice\">\n    <div class=\"field\" id=\"field\" tabindex=\"0\" role=\"application\" aria-label=\"曲库拼贴墙，Ctrl + Space 打开功能面板\" aria-keyshortcuts=\"Control+Space\">\n      <div class=\"world\" id=\"world\"></div>\n      <div class=\"field__vignette\" aria-hidden=\"true\"></div>\n    </div>\n    <button class=\"locate\" id=\"locate\" type=\"button\" data-visible=\"false\" aria-label=\"定位到正在播放的歌曲\" title=\"定位到正在播放的歌曲 (C)\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\" focusable=\"false\">\n        <circle cx=\"12\" cy=\"12\" r=\"6.5\"/>\n        <circle cx=\"12\" cy=\"12\" r=\"2\" fill=\"currentColor\" stroke=\"none\"/>\n        <path d=\"M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3\"/>\n      </svg>\n    </button>\n    <section class=\"state\" id=\"state\" role=\"status\" aria-live=\"polite\" hidden></section>\n  </main>\n  <script src=\"__bridge__.js\"></script>\n  <script src=\"panel.js\"></script>\n</body>\n</html>\n"
    },
