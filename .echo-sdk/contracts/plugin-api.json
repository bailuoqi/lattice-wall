    "library:liked-changed": "library:read",
    "settings:changed": "fs:plugin"
  },
  "commonErrors": {
    "panel-context-required": {
      "retry": false,
      "recovery": "Call panel presentation or close methods only from the currently visible sandbox panel; background runtimes cannot mutate host chrome."
    },
    "capability-denied": {
      "retry": false,
      "recovery": "Declare the listed permission, rerun check, and let the subscriber review the changed capability."
    },
    "action-unavailable": {
      "retry": false,
      "recovery": "Check API 2 compatibility and the minimum ECHO version; do not probe undocumented host actions."
    },
    "invalid-payload": {
      "retry": false,
      "recovery": "Validate and bound the arguments before calling the method."
    },
    "message-too-large": {
      "retry": false,
      "recovery": "Reduce the serialized request below the documented bridge message limit."
    },
    "response-too-large": {
      "retry": false,
      "recovery": "Request a bounded page or smaller result; the host will not forward an oversized response."
    },
    "rate-limited": {
      "retry": true,
      "recovery": "Back off and coalesce repeated reads or UI events."
    },
    "concurrency-limited": {
      "retry": true,
      "recovery": "Await outstanding host requests and keep at most 8 in flight."
    },
    "plugin-request-concurrency-exceeded": {
      "retry": true,
      "recovery": "Await outstanding bridge requests and keep at most 32 promises pending."
    },
    "plugin-request-timeout": {
      "retry": true,
      "recovery": "Handle the failure; retry only idempotent reads with backoff."
    },
    "trusted-runtime-concurrency-limited": {
      "retry": true,
      "recovery": "Await outstanding full-trust invokes and keep at most 32 pending for one plug-in."
    },
    "trusted-runtime-input-invalid": {
      "retry": false,
      "recovery": "Pass a JSON-serializable input below the trusted runtime input limit."
    },
    "trusted-runtime-result-invalid": {
      "retry": false,
      "recovery": "Return a JSON-serializable bounded result from trustedEntry."
    },
    "trusted-runtime-heartbeat-timeout": {
      "retry": false,
      "recovery": "The utility process stopped responding and was terminated; inspect the plug-in before manually retrying."
    },
    "trusted-runtime-quarantined": {
      "retry": false,
      "recovery": "The plug-in crashed three times in ten minutes; review it and explicitly re-enable it to retry."
    },
    "command-unavailable": {
      "retry": false,
      "recovery": "Refresh host state and disable the unavailable control."
    },
    "queue-unavailable": {
      "retry": true,
      "recovery": "Wait for the host queue to become ready before retrying."
    },
    "playback-unavailable": {
      "retry": true,
      "recovery": "Wait for playback initialization and refresh status."
    },
    "library-unavailable": {
      "retry": true,
      "recovery": "Wait for library initialization and rerun the read."
    },
    "direct-source-denied": {
      "retry": false,
      "recovery": "The subscriber denied this origin for the session; do not prompt in a loop."
    },
    "share-denied": {
      "retry": false,
      "recovery": "The subscriber denied this upload; keep the feature idle until another explicit action."
    },
    "network-host-denied": {
      "retry": false,
      "recovery": "Use a default-port HTTP(S) host declared in networkHosts; private, reserved and undeclared targets remain blocked."
    },
    "network-port-denied": {
      "retry": false,
      "recovery": "Use the default HTTPS port; custom ports are outside the plug-in network contract."
    },
    "network-address-denied": {
      "retry": false,
      "recovery": "Use a public destination; loopback, LAN, reserved and mixed public/private DNS answers are blocked."
    },
    "network-capability-denied": {
      "retry": false,
      "recovery": "Declare network:request and the exact networkHosts entry, then let the subscriber review the capability."
    },
    "share-destination-denied": {
      "retry": false,
      "recovery": "Use a default-port HTTP(S) upload host declared by the plug-in and approved for playback sharing; HTTPS is strongly recommended."
    },
    "track-unavailable": {
      "retry": false,
      "recovery": "Refresh the sanitized library or queue snapshot and stop using the stale track id."
    },
    "playlist-unavailable": {
      "retry": false,
      "recovery": "Refresh local playlists; remote or removed playlists cannot be controlled through this API."
    },
    "setting-undeclared": {
      "retry": false,
      "recovery": "Declare the setting in manifest.contributes.settings before reading or writing it."
    },
    "storage-quota-exceeded": {
      "retry": false,
      "recovery": "Reduce the JSON value below 16 KiB and the plug-in namespace below 64 KiB."
    }
  }
}
