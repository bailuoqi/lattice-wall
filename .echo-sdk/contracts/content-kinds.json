    "lyrics-style": { "entry": "lyrics-scene.json", "tag": "Lyrics Scene" },
    "animation-library": { "entry": "animation-library.json", "tag": "Lyrics Scene" },
    "visualizer-preset": { "entry": "visualizer.json", "tag": "Visualizer Preset" },
    "dsp-preset": { "entry": "dsp-preset.json", "tag": "DSP / EQ Preset" },
    "audio-plugin-profile": { "entry": "audio-plugin-profile.json", "tag": "DSP / EQ Preset" },
    "locale-pack": { "entry": "locale.json", "tag": "Language Pack" },
    "plugin-package": { "entry": "community.echo", "tag": "Sandboxed Plugin" },
    "native-shell": { "entry": "native-shell.json", "tag": "Native Shell" }
  }
}
