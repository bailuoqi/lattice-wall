{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo.example/schemas/workshop/project.schema.json",
  "title": "ECHO Workshop authoring project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "appId",
    "publishedFileId",
    "contentDirectory",
    "previewFile",
    "visibility",
    "description",
    "changeNote",
    "tags"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "appId": { "const": "5105090" },
    "publishedFileId": { "type": "string", "pattern": "^(?:0|[1-9]\\d{0,19})$" },
    "contentDirectory": { "$ref": "#/$defs/path" },
    "previewFile": {
      "allOf": [
        { "$ref": "#/$defs/path" },
        { "pattern": "\\.(?:[gG][iI][fF]|[jJ][pP][eE]?[gG]|[pP][nN][gG])$" }
      ]
    },
    "visibility": { "enum": ["private", "friends-only", "unlisted", "public"] },
    "description": { "type": "string", "minLength": 1, "maxLength": 8000, "pattern": "\\S" },
    "changeNote": { "type": "string", "minLength": 1, "maxLength": 8000, "pattern": "\\S" },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "\\S" }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^<>:\"|?*]+$"
    }
  }
}
