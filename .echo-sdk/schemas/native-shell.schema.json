{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo.example/schemas/workshop/native-shell.schema.json",
  "title": "ECHO Workshop native-shell entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "schemaVersion", "id", "title", "protocolVersion", "platforms", "exe", "permissions"],
  "properties": {
    "$schema": { "type": "string" },
    "type": { "const": "echo-workshop-native-shell" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 3, "maxLength": 80, "pattern": "^[a-z0-9](?:[a-z0-9._-]{1,78}[a-z0-9])?$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 8000 },
    "protocolVersion": { "const": 1 },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["win32"] }
    },
    "exe": {
      "type": "string",
      "minLength": 5,
      "maxLength": 240,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^<>:\"|?*]+\\.[eE][xX][eE]$"
    },
    "renderer": { "$ref": "#/$defs/path" },
    "config": { "$ref": "#/$defs/path" },
    "configSchema": { "$ref": "#/$defs/path" },
    "configUi": { "$ref": "#/$defs/path" },
    "icon": { "$ref": "#/$defs/path" },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "enum": [
          "process:spawn",
          "ipc:named-pipe",
          "shell:taskbar",
          "cover:original",
          "window:focus",
          "playback:read",
          "playback:control",
          "lyrics:read"
        ]
      }
    },
    "pipe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "argument": { "const": "--pipe" },
        "stdio": { "const": "ignore" }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^<>:\"|?*]+$"
    }
  }
}
