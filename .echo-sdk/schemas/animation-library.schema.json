{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo.example/schemas/workshop/animation-library.schema.json",
  "title": "ECHO Workshop animation library",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "schemaVersion", "id", "title", "animations"],
  "properties": {
    "type": { "const": "echo-workshop-animation-library" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 3, "maxLength": 80 },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 300 },
    "animations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "keyframes"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 48, "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,46}[a-z0-9])?$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "maxLength": 300 },
          "trigger": { "enum": ["scene-enter", "track-change", "line-change", "ambient"] },
          "durationMs": { "type": "integer", "minimum": 80, "maximum": 30000 },
          "delayMs": { "type": "integer", "minimum": 0, "maximum": 30000 },
          "easing": { "enum": ["linear", "ease", "ease-in", "ease-out", "ease-in-out", "echo-spring", "echo-snappy", "echo-gentle", "echo-elastic"] },
          "loop": { "type": "boolean" },
          "direction": { "enum": ["normal", "reverse", "alternate", "alternate-reverse"] },
          "origin": { "enum": ["center", "top", "right", "bottom", "left", "top-left", "top-right", "bottom-right", "bottom-left"] },
          "clipDirection": { "enum": ["left-to-right", "right-to-left", "top-to-bottom", "bottom-to-top", "center-out-x", "center-out-y"] },
          "stagger": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stepMs"],
            "properties": {
              "stepMs": { "type": "integer", "minimum": 0, "maximum": 800 },
              "maxDelayMs": { "type": "integer", "minimum": 0, "maximum": 5000 },
              "from": { "enum": ["first", "center", "last", "edges"] }
            }
          },
          "keyframes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset"],
              "properties": {
                "offset": { "type": "number", "minimum": 0, "maximum": 1 },
                "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
                "translateX": { "type": "number", "minimum": -512, "maximum": 512 },
                "translateY": { "type": "number", "minimum": -512, "maximum": 512 },
                "translateZ": { "type": "number", "minimum": -256, "maximum": 256 },
                "scale": { "type": "number", "minimum": 0.1, "maximum": 4 },
                "rotateXDeg": { "type": "number", "minimum": -180, "maximum": 180 },
                "rotateYDeg": { "type": "number", "minimum": -180, "maximum": 180 },
                "rotateDeg": { "type": "number", "minimum": -360, "maximum": 360 },
                "skewXDeg": { "type": "number", "minimum": -45, "maximum": 45 },
                "skewYDeg": { "type": "number", "minimum": -45, "maximum": 45 },
                "clipProgress": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
