{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo.example/schemas/workshop/locale-pack.schema.json",
  "title": "ECHO Workshop locale pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "schemaVersion", "id", "title", "locale", "label", "nativeLabel", "strings"],
  "properties": {
    "type": { "const": "echo-workshop-locale-pack" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 3, "maxLength": 80 },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 300 },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "^[a-z]{2,8}(?:-[A-Za-z0-9]{1,8}){0,3}$",
      "description": "BCP-47 locale that is not one of ECHO's five built-in languages."
    },
    "label": { "type": "string", "minLength": 1, "maxLength": 80 },
    "nativeLabel": { "type": "string", "minLength": 1, "maxLength": 80 },
    "fallback": {
      "type": "string",
      "enum": ["zh-CN", "zh-TW", "en-US", "ja-JP", "ko-KR"],
      "default": "zh-CN"
    },
    "strings": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8192,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "rewrites": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1, "maxLength": 40 },
          "to": { "type": "string", "maxLength": 40 }
        }
      }
    }
  }
}
